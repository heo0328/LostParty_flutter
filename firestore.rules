rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function bindingPath(authUid) {
      return /databases/$(database)/documents/authBindings/$(authUid);
    }

    function playerPath(playerId) {
      return /databases/$(database)/documents/players/$(playerId);
    }

    function hasActiveBinding() {
      return signedIn()
        && exists(bindingPath(request.auth.uid))
        && get(bindingPath(request.auth.uid)).data.status == 'active';
    }

    function currentPlayerId() {
      return get(bindingPath(request.auth.uid)).data.playerId;
    }

    function recruitmentPath(recruitmentId) {
      return /databases/$(database)/documents/recruitments/$(recruitmentId);
    }

    function recruitmentMemberPath(recruitmentId, playerId) {
      return /databases/$(database)/documents/recruitments/$(recruitmentId)/members/$(playerId);
    }

    function assignmentPath(playerId, assignmentId) {
      return /databases/$(database)/documents/players/$(playerId)/activeRaidAssignments/$(assignmentId);
    }

    function characterPath(characterId) {
      return /databases/$(database)/documents/characters/$(characterId);
    }

    function ownsActiveCharacter(characterId) {
      let character = get(characterPath(characterId)).data;
      return character.status == 'active'
        && character.ownerPlayerId == currentPlayerId();
    }

    function ownsActiveCharacterForPlayer(characterId, playerId) {
      let character = get(characterPath(characterId)).data;
      return character.status == 'active'
        && character.ownerPlayerId == playerId;
    }

    function canApproveApplications(recruitmentId) {
      let recruitment = get(recruitmentPath(recruitmentId)).data;
      let playerId = currentPlayerId();
      return recruitment.leaderPlayerId == playerId
        || (exists(recruitmentMemberPath(recruitmentId, playerId))
          && get(recruitmentMemberPath(recruitmentId, playerId))
            .data.canApproveApplications == true);
    }

    function validInitialRecruitment(recruitmentId, data) {
      let playerId = currentPlayerId();
      let member = getAfter(recruitmentMemberPath(recruitmentId, playerId)).data;
      let assignmentId = member.characterId + '_' + data.raidId;
      return hasActiveBinding()
        && data.schemaVersion == 1
        && data.leaderPlayerId == playerId
        && data.memberPlayerIds == [playerId]
        && data.memberCount == 1
        && data.maxMemberCount >= 1
        && data.dealerCount + data.supportCount == 1
        && data.status == 'active'
        && data.visibility == 'public'
        && data.currentCycleKey == data.targetCycleKey
        && data.revision == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && member.playerId == playerId
        && member.joinedBy == playerId
        && member.partyIndex == 0
        && member.canApproveApplications == true
        && ownsActiveCharacter(member.characterId)
        && getAfter(assignmentPath(playerId, assignmentId)).data.recruitmentId
          == recruitmentId;
    }

    function validInitialLeaderMembership(recruitmentId, playerId, data) {
      let recruitment = getAfter(recruitmentPath(recruitmentId)).data;
      let assignmentId = data.characterId + '_' + recruitment.raidId;
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && data.schemaVersion == 1
        && data.playerId == playerId
        && data.joinedBy == playerId
        && data.partyIndex == 0
        && data.canApproveApplications == true
        && data.joinedAt == request.time
        && data.updatedAt == request.time
        && recruitment.leaderPlayerId == playerId
        && recruitment.memberPlayerIds == [playerId]
        && ownsActiveCharacter(data.characterId)
        && getAfter(assignmentPath(playerId, assignmentId)).data.recruitmentId
          == recruitmentId;
    }

    function validInitialAssignment(playerId, assignmentId, data) {
      let recruitment = getAfter(recruitmentPath(data.recruitmentId)).data;
      let member = getAfter(
        recruitmentMemberPath(data.recruitmentId, playerId)
      ).data;
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && data.schemaVersion == 1
        && data.playerId == playerId
        && assignmentId == data.characterId + '_' + data.raidId
        && data.cycleKey == recruitment.currentCycleKey
        && data.raidId == recruitment.raidId
        && data.characterId == member.characterId
        && data.role == member.role
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && recruitment.leaderPlayerId == playerId
        && ownsActiveCharacter(data.characterId);
    }

    function validJoinedMembership(recruitmentId, playerId, data) {
      let before = get(recruitmentPath(recruitmentId)).data;
      let after = getAfter(recruitmentPath(recruitmentId)).data;
      let assignmentId = data.characterId + '_' + after.raidId;
      let directJoin = playerId == currentPlayerId()
        && before.approvalPolicy.mode == 'directJoin'
        && data.joinedBy == playerId;
      let approvedJoin = canApproveApplications(recruitmentId)
        && data.joinedBy == currentPlayerId();
      return hasActiveBinding()
        && data.schemaVersion == 1
        && data.playerId == playerId
        && data.partyIndex >= 0
        && data.partyIndex < after.partyCount
        && data.canApproveApplications == false
        && data.joinedAt == request.time
        && data.updatedAt == request.time
        && ownsActiveCharacterForPlayer(data.characterId, playerId)
        && !(playerId in before.memberPlayerIds)
        && playerId in after.memberPlayerIds
        && (directJoin || approvedJoin)
        && getAfter(assignmentPath(playerId, assignmentId)).data.recruitmentId
          == recruitmentId;
    }

    function validJoinedAssignment(playerId, assignmentId, data) {
      let recruitment = getAfter(recruitmentPath(data.recruitmentId)).data;
      let member = getAfter(recruitmentMemberPath(data.recruitmentId, playerId)).data;
      return hasActiveBinding()
        && data.schemaVersion == 1
        && data.playerId == playerId
        && assignmentId == data.characterId + '_' + data.raidId
        && data.cycleKey == recruitment.targetCycleKey
        && data.raidId == recruitment.raidId
        && data.characterId == member.characterId
        && data.role == member.role
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && ownsActiveCharacterForPlayer(data.characterId, playerId)
        && playerId in recruitment.memberPlayerIds
        && (playerId == currentPlayerId()
          || canApproveApplications(data.recruitmentId));
    }

    function validRecruitmentJoin(recruitmentId, oldData, newData) {
      let added = newData.memberPlayerIds.toSet().difference(
        oldData.memberPlayerIds.toSet()
      );
      return hasActiveBinding()
        && oldData.status == 'active'
        && oldData.manualRecruitmentEnabled == true
        && oldData.hasAvailableSlot == true
        && newData.diff(oldData).affectedKeys().hasOnly([
          'memberPlayerIds', 'memberCount', 'dealerCount', 'supportCount',
          'hasAvailableSlot', 'revision', 'updatedAt'
        ])
        && added.size() == 1
        && newData.memberPlayerIds.size() == oldData.memberPlayerIds.size() + 1
        && newData.memberCount == oldData.memberCount + 1
        && newData.dealerCount + newData.supportCount
          == oldData.dealerCount + oldData.supportCount + 1
        && newData.memberCount == newData.dealerCount + newData.supportCount
        && newData.memberCount <= newData.maxMemberCount
        && newData.hasAvailableSlot
          == (newData.memberCount < newData.maxMemberCount)
        && newData.revision == oldData.revision + 1
        && newData.updatedAt == request.time;
    }

    function validPendingApplication(recruitmentId, playerId, data) {
      let recruitment = get(recruitmentPath(recruitmentId)).data;
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && data.schemaVersion == 1
        && data.recruitmentId == recruitmentId
        && data.applicantPlayerId == playerId
        && data.cycleKey == recruitment.targetCycleKey
        && data.status == 'pending'
        && data.revision == 1
        && data.approvalCount == 0
        && data.rejectionCount == 0
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && recruitment.status == 'active'
        && recruitment.manualRecruitmentEnabled == true
        && recruitment.hasAvailableSlot == true
        && recruitment.approvalPolicy.mode == 'leaderOnly'
        && !(playerId in recruitment.memberPlayerIds)
        && ownsActiveCharacter(data.characterId);
    }

    function validApplicantWithdrawal(playerId, oldData, newData) {
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && oldData.applicantPlayerId == playerId
        && oldData.status == 'pending'
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'resolutionReason', 'revision', 'decidedAt', 'updatedAt'
        ])
        && newData.status == 'withdrawn'
        && newData.resolutionReason == 'withdrawnByApplicant'
        && newData.revision == oldData.revision + 1
        && newData.decidedAt == request.time
        && newData.updatedAt == request.time;
    }

    function validApplicationDecision(recruitmentId, oldData, newData) {
      let approved = newData.status == 'approved'
        && newData.approvalCount == oldData.approvalCount + 1
        && newData.rejectionCount == oldData.rejectionCount
        && existsAfter(recruitmentMemberPath(
          recruitmentId,
          oldData.applicantPlayerId
        ));
      let rejected = newData.status == 'rejected'
        && newData.rejectionCount == oldData.rejectionCount + 1
        && newData.approvalCount == oldData.approvalCount;
      return hasActiveBinding()
        && canApproveApplications(recruitmentId)
        && oldData.status == 'pending'
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'resolutionReason', 'approvalCount', 'rejectionCount',
          'revision', 'decidedAt', 'updatedAt'
        ])
        && ((approved && newData.resolutionReason == 'approvedByApprover')
          || (rejected && newData.resolutionReason == 'rejectedByApprover'))
        && newData.revision == oldData.revision + 1
        && newData.decidedAt == request.time
        && newData.updatedAt == request.time;
    }

    function canReadRecruitment(data) {
      return hasActiveBinding()
        && (data.visibility == 'public'
          || data.leaderPlayerId == currentPlayerId()
          || currentPlayerId() in data.memberPlayerIds);
    }

    function canReadPrivateRecruitmentData(recruitmentId) {
      let recruitment = get(recruitmentPath(recruitmentId)).data;
      return hasActiveBinding()
        && (recruitment.leaderPlayerId == currentPlayerId()
          || currentPlayerId() in recruitment.memberPlayerIds);
    }

    function validActiveBinding(data) {
      return data.keys().hasOnly([
          'schemaVersion',
          'playerId',
          'status',
          'linkedAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.playerId is string
        && data.playerId.size() > 0
        && data.status == 'active'
        && data.linkedAt == request.time
        && data.updatedAt == request.time;
    }

    function validActivePlayer(data) {
      return data.keys().hasOnly([
          'schemaVersion',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.status == 'active'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /authBindings/{authUid} {
      allow get: if signedIn() && request.auth.uid == authUid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == authUid
        && !exists(bindingPath(authUid))
        && validActiveBinding(request.resource.data)
        && !exists(playerPath(request.resource.data.playerId))
        && getAfter(playerPath(request.resource.data.playerId)).data.status
          == 'active';
      allow update, delete: if false;
    }

    match /players/{playerId} {
      allow get: if signedIn()
        && exists(bindingPath(request.auth.uid))
        && get(bindingPath(request.auth.uid)).data.playerId == playerId;
      allow list: if false;
      allow create: if signedIn()
        && !exists(bindingPath(request.auth.uid))
        && validActivePlayer(request.resource.data)
        && getAfter(bindingPath(request.auth.uid)).data.playerId == playerId;
      allow update, delete: if false;

      match /activeRaidAssignments/{assignmentId} {
        allow get: if hasActiveBinding() && playerId == currentPlayerId();
        allow list: if false;
      allow create: if validInitialAssignment(
          playerId,
          assignmentId,
          request.resource.data
        ) || validJoinedAssignment(playerId, assignmentId, request.resource.data);
        allow update, delete: if false;
      }
    }

    match /accountVerificationChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /activeAccountVerificationChallenges/{playerId} {
      allow read, write: if false;
    }

    match /gameAccounts/{gameAccountId} {
      allow read, write: if signedIn();
    }

    match /characters/{characterId} {
      allow read, write: if signedIn();
    }

    match /characterIdentityClaims/{claimId} {
      allow read, write: if signedIn();
    }

    match /playerGameAccounts/{ownershipId} {
      allow read, write: if signedIn();
    }

    match /recruitments/{recruitmentId} {
      allow get, list: if canReadRecruitment(resource.data);
      allow create: if validInitialRecruitment(
        recruitmentId,
        request.resource.data
      );
      allow update: if validRecruitmentJoin(
        recruitmentId,
        resource.data,
        request.resource.data
      );
      allow delete: if false;

      match /members/{playerId} {
        allow get, list: if canReadPrivateRecruitmentData(recruitmentId)
          || (hasActiveBinding() && playerId == currentPlayerId());
        allow create: if validInitialLeaderMembership(
          recruitmentId,
          playerId,
          request.resource.data
        ) || validJoinedMembership(
          recruitmentId,
          playerId,
          request.resource.data
        );
        allow update, delete: if false;
      }

      match /applications/{playerId} {
        allow get, list: if canReadPrivateRecruitmentData(recruitmentId)
          || (hasActiveBinding()
            && resource.data.applicantPlayerId == currentPlayerId());
        allow create: if validPendingApplication(
          recruitmentId,
          playerId,
          request.resource.data
        );
        allow update: if validApplicantWithdrawal(
            playerId,
            resource.data,
            request.resource.data
          ) || validApplicationDecision(
            recruitmentId,
            resource.data,
            request.resource.data
          );
        allow delete: if false;

        match /votes/{voterPlayerId} {
          allow get, list: if canReadPrivateRecruitmentData(recruitmentId);
          allow create, update, delete: if false;
        }
      }
    }
  }
}
