allow list: if false;
allow create: if rf270(code, request.resource.data);
allow update: if false;
allow delete: if rf271(code);
}
match /{path=**}/applications/{applicantPlayerId} {
allow list: if rf4()
&& resource.data.applicantPlayerId == rf5();
}
}
}
