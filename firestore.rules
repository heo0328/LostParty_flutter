rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function bindingPath(authUid) {
      return /databases/$(database)/documents/authBindings/$(authUid);
    }

    function playerPath(playerId) {
      return /databases/$(database)/documents/players/$(playerId);
    }

    function operatorAssignmentPath(playerId) {
      return /databases/$(database)/documents/operatorAssignments/$(playerId);
    }

    function hasActiveBinding() {
      return signedIn()
        && exists(bindingPath(request.auth.uid))
        && get(bindingPath(request.auth.uid)).data.status == 'active';
    }

    function currentPlayerId() {
      return get(bindingPath(request.auth.uid)).data.playerId;
    }

    function isActiveOperator() {
      return hasActiveBinding()
        && exists(playerPath(currentPlayerId()))
        && get(playerPath(currentPlayerId())).data.status == 'active'
        && exists(operatorAssignmentPath(currentPlayerId()))
        && get(operatorAssignmentPath(currentPlayerId())).data.status == 'active';
    }

    function recruitmentPath(recruitmentId) {
      return /databases/$(database)/documents/recruitments/$(recruitmentId);
    }

    function recruitmentMemberPath(recruitmentId, playerId) {
      return /databases/$(database)/documents/recruitments/$(recruitmentId)/members/$(playerId);
    }

    function recruitmentSlotPath(recruitmentId, partyIndex, slotIndex) {
      return /databases/$(database)/documents/recruitments/$(recruitmentId)/slots/$(partyIndex)_$(slotIndex);
    }

    function partySlotIsSupport(recruitmentId, partyIndex, slotIndex) {
      let slot = recruitmentSlotPath(recruitmentId, partyIndex, slotIndex);
      return existsAfter(slot) && getAfter(slot).data.role == 'support';
    }

    function partySlotIsSameDealerClass(
      recruitmentId,
      partyIndex,
      slotIndex,
      className
    ) {
      let slot = recruitmentSlotPath(recruitmentId, partyIndex, slotIndex);
      return existsAfter(slot)
        && getAfter(slot).data.role == 'dealer'
        && getAfter(slot).data.classNameSnapshot == className;
    }

    function validPartyCompositionForMember(recruitmentId, member) {
      let recruitment = getAfter(recruitmentPath(recruitmentId)).data;
      let supportCount =
        (partySlotIsSupport(recruitmentId, member.partyIndex, 0) ? 1 : 0)
        + (partySlotIsSupport(recruitmentId, member.partyIndex, 1) ? 1 : 0)
        + (partySlotIsSupport(recruitmentId, member.partyIndex, 2) ? 1 : 0)
        + (partySlotIsSupport(recruitmentId, member.partyIndex, 3) ? 1 : 0);
      let sameDealerClassCount =
        (partySlotIsSameDealerClass(
          recruitmentId,
          member.partyIndex,
          0,
          member.classNameSnapshot
        ) ? 1 : 0)
        + (partySlotIsSameDealerClass(
          recruitmentId,
          member.partyIndex,
          1,
          member.classNameSnapshot
        ) ? 1 : 0)
        + (partySlotIsSameDealerClass(
          recruitmentId,
          member.partyIndex,
          2,
          member.classNameSnapshot
        ) ? 1 : 0)
        + (partySlotIsSameDealerClass(
          recruitmentId,
          member.partyIndex,
          3,
          member.classNameSnapshot
        ) ? 1 : 0);
      return supportCount <= recruitment.supportsPerParty
        && (member.role != 'dealer'
          || sameDealerClassCount
            <= recruitment.maxDealersPerClassPerParty);
    }

    function recruitmentApplicationPath(recruitmentId, applicantPlayerId) {
      return /databases/$(database)/documents/recruitments/$(recruitmentId)/applications/$(applicantPlayerId);
    }

    function recruitmentCyclePath(recruitmentId, cycleKey) {
      return /databases/$(database)/documents/recruitments/$(recruitmentId)/cycles/$(cycleKey);
    }

    function assignmentPath(playerId, assignmentId) {
      return /databases/$(database)/documents/players/$(playerId)/activeRaidAssignments/$(assignmentId);
    }

    function weeklyRaidClaimId(cycleKey, characterId, raidId) {
      return cycleKey + '_' + characterId + '_' + raidId;
    }

    function weeklyRaidClaimPath(playerId, cycleKey, characterId, raidId) {
      return /databases/$(database)/documents/players/$(playerId)/weeklyRaidClaims/$(weeklyRaidClaimId(cycleKey, characterId, raidId));
    }

    function hasWeeklyRaidClaimAfter(playerId, cycleKey, characterId, raidId) {
      return existsAfter(weeklyRaidClaimPath(
        playerId,
        cycleKey,
        characterId,
        raidId
      ));
    }

    function characterPath(characterId) {
      return /databases/$(database)/documents/characters/$(characterId);
    }

    function ownsActiveCharacter(characterId) {
      let character = get(characterPath(characterId)).data;
      return character.status == 'active'
        && character.ownerPlayerId == currentPlayerId();
    }

    function ownsActiveCharacterForPlayer(characterId, playerId) {
      let character = get(characterPath(characterId)).data;
      return character.status == 'active'
        && character.ownerPlayerId == playerId;
    }

    // Task-11 Unit 1~4: 그룹 생성·공개 읽기, 초대·신청·승인·금지와
    // 초대코드 생성·폐기·즉시 가입을 연다.
    // 탈퇴·추방·이전·해산 쓰기는 계속 닫아 둔다.
    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function groupMemberPath(groupId, playerId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(playerId);
    }

    function groupMembershipStatePath(playerId) {
      return /databases/$(database)/documents/players/$(playerId)/groupMembershipState/current;
    }

    function groupRelationPath(playerId, groupId) {
      return /databases/$(database)/documents/players/$(playerId)/groupRelations/$(groupId);
    }

    function groupJoinRelationPath(groupId, playerId) {
      return /databases/$(database)/documents/groups/$(groupId)/joinRelations/$(playerId);
    }

    function groupApplicantStatsPath(groupId, playerId) {
      return /databases/$(database)/documents/groups/$(groupId)/applicantStats/$(playerId);
    }

    function groupBlockPath(groupId, playerId) {
      return /databases/$(database)/documents/groups/$(groupId)/blockedPlayers/$(playerId);
    }

    // 금지 목록은 그룹장만 읽지만 exists()는 호출자 읽기 권한과 무관하다.
    // 본·부계정과 Character 변경은 Player 단위 block을 우회하지 못한다.
    function hasGroupBlock(groupId, playerId) {
      return exists(groupBlockPath(groupId, playerId));
    }

    function isCurrentPlayerActive() {
      return hasActiveBinding()
        && get(playerPath(currentPlayerId())).data.status == 'active';
    }

    function isCurrentGroupMember(groupId) {
      return hasActiveBinding()
        && exists(groupMemberPath(groupId, currentPlayerId()));
    }

    function isGroupOnlyRecruitment(data) {
      return data.visibility == 'group'
        && data.groupId is string
        && data.groupId.size() > 0;
    }

    // 그룹 전용 레이드에서 대상이 그룹 membership을 잃었고,
    // 요청자는 같은 레이드·그룹의 현재 멤버일 때만 제한적 정리를 허용한다.
    function isLostGroupQualificationCleanup(recruitment, actorPlayerId, targetPlayerId) {
      return isGroupOnlyRecruitment(recruitment)
        && actorPlayerId != targetPlayerId
        && actorPlayerId in recruitment.memberPlayerIds
        && targetPlayerId in recruitment.memberPlayerIds
        && exists(groupMemberPath(recruitment.groupId, actorPlayerId))
        && !exists(groupMemberPath(recruitment.groupId, targetPlayerId));
    }

    // 삼항을 한 함수에 16단 중첩하면 컴파일러가 괄호를 닫지 못한다.
    function removedMemberId(oldIds, newIds) {
      let kept = newIds.toSet();
      let low = removedMemberIdLow(oldIds, kept);
      return low.size() > 0 ? low : removedMemberIdHigh(oldIds, kept);
    }

    function removedMemberIdLow(oldIds, kept) {
      return oldIds.size() > 0 && !kept.hasAny([oldIds[0]]) ? oldIds[0]
        : (oldIds.size() > 1 && !kept.hasAny([oldIds[1]]) ? oldIds[1]
        : (oldIds.size() > 2 && !kept.hasAny([oldIds[2]]) ? oldIds[2]
        : (oldIds.size() > 3 && !kept.hasAny([oldIds[3]]) ? oldIds[3]
        : (oldIds.size() > 4 && !kept.hasAny([oldIds[4]]) ? oldIds[4]
        : (oldIds.size() > 5 && !kept.hasAny([oldIds[5]]) ? oldIds[5]
        : (oldIds.size() > 6 && !kept.hasAny([oldIds[6]]) ? oldIds[6]
        : (oldIds.size() > 7 && !kept.hasAny([oldIds[7]]) ? oldIds[7]
        : '')))))));
    }

    function removedMemberIdHigh(oldIds, kept) {
      return oldIds.size() > 8 && !kept.hasAny([oldIds[8]]) ? oldIds[8]
        : (oldIds.size() > 9 && !kept.hasAny([oldIds[9]]) ? oldIds[9]
        : (oldIds.size() > 10 && !kept.hasAny([oldIds[10]]) ? oldIds[10]
        : (oldIds.size() > 11 && !kept.hasAny([oldIds[11]]) ? oldIds[11]
        : (oldIds.size() > 12 && !kept.hasAny([oldIds[12]]) ? oldIds[12]
        : (oldIds.size() > 13 && !kept.hasAny([oldIds[13]]) ? oldIds[13]
        : (oldIds.size() > 14 && !kept.hasAny([oldIds[14]]) ? oldIds[14]
        : (oldIds.size() > 15 && !kept.hasAny([oldIds[15]]) ? oldIds[15]
        : '')))))));
    }

    function isCurrentGroupLeader(groupId) {
      return hasActiveBinding()
        && get(groupPath(groupId)).data.leaderPlayerId == currentPlayerId();
    }

    function validGroupRaidListingCreate(groupId, recruitmentId, data) {
      let recruitment = getAfter(recruitmentPath(recruitmentId)).data;
      let created = !exists(recruitmentPath(recruitmentId));
      return isCurrentGroupMember(groupId)
        && recruitment.groupId == groupId
        && recruitment.visibility == 'group'
        && data.diff(recruitment).affectedKeys().size() == 0
        && (
          created
            ? recruitment.revision == 1
              && recruitment.leaderPlayerId == currentPlayerId()
              && recruitment.updatedAt == request.time
            : recruitment.revision
              == get(recruitmentPath(recruitmentId)).data.revision + 1
              && recruitment.updatedAt == request.time
        );
    }

    function validGroupRaidListingBackfill(groupId, recruitmentId, data) {
      let recruitment = getAfter(recruitmentPath(recruitmentId)).data;
      return exists(recruitmentPath(recruitmentId))
        && isCurrentGroupMember(groupId)
        && recruitment.groupId == groupId
        && recruitment.visibility == 'group'
        && recruitment.status != 'disbanded'
        && recruitment.currentCycleStatus != 'disbanded'
        && data.diff(recruitment).affectedKeys().size() == 0
        && recruitment.revision
          == get(recruitmentPath(recruitmentId)).data.revision
        && currentPlayerId() in recruitment.memberPlayerIds;
    }

    // 직접 입력 그룹명은 trim 후 1~20자이며 줄바꿈·제어문자를 포함하지 않는다.
    // Rules는 Unicode 정규화 결과를 재계산하지 못하므로 원문 형식만 강제한다.
    function validGroupDisplayName(name) {
      return name is string
        && name.size() >= 1
        && name.size() <= 20
        && !name.matches('(?s).*[\\x00-\\x1f\\x7f].*');
    }

    function validGroupSearchProjection(data) {
      return data.normalizedName is string
        && data.normalizedName.size() >= 1
        && data.normalizedName.size() <= 20
        && data.normalizedRepresentativeCharacterName is string
        && data.normalizedRepresentativeCharacterName.size() >= 1
        && data.normalizedRepresentativeCharacterName.size() <= 40;
    }

    function validInitialGroup(groupId, data) {
      let playerId = currentPlayerId();
      let member = getAfter(groupMemberPath(groupId, playerId)).data;
      let state = getAfter(groupMembershipStatePath(playerId)).data;
      return isCurrentPlayerActive()
        && data.keys().hasOnly([
          'schemaVersion', 'status', 'name', 'normalizedName',
          'representativeCharacterId', 'representativeCharacterNameSnapshot',
          'normalizedRepresentativeCharacterName',
          'representativeServerNameSnapshot', 'leaderPlayerId',
          'leaderDisplayCharacterNameSnapshot', 'memberCount', 'revision',
          'hasActiveJoinCode', 'activeJoinCode', 'joinCodeVisibleToMembers', 'lastActivityAt',
          'createdAt', 'updatedAt', 'deletedAt'
        ])
        && data.schemaVersion == 1
        && data.status == 'active'
        && validGroupDisplayName(data.name)
        && validGroupSearchProjection(data)
        && data.representativeCharacterNameSnapshot is string
        && data.representativeCharacterNameSnapshot.size() > 0
        && data.representativeServerNameSnapshot is string
        && data.representativeServerNameSnapshot.size() > 0
        && data.leaderPlayerId == playerId
        && data.leaderDisplayCharacterNameSnapshot
          == data.representativeCharacterNameSnapshot
        && data.memberCount == 1
        && data.revision == 1
        && data.slotLedgerVersion == 1
        && data.hasActiveJoinCode == false
        && (!('activeJoinCode' in data) || data.activeJoinCode == null)
        && data.joinCodeVisibleToMembers == false
        && data.deletedAt == null
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.lastActivityAt == request.time
        && ownsActiveCharacter(data.representativeCharacterId)
        && member.playerId == playerId
        && member.role == 'leader'
        && member.joinSequence == 1
        && member.joinedBy == 'created'
        && member.displayCharacterIdSnapshot == data.representativeCharacterId
        && groupId in state.activeGroupIds
        && existsAfter(groupRelationPath(playerId, groupId));
    }

    function validInitialGroupMember(groupId, playerId, data) {
      let group = getAfter(groupPath(groupId)).data;
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && validNewGroupMemberCore(groupId, playerId, data)
        && validGroupMemberSnapshotsFromCharacter(
          data,
          data.displayCharacterIdSnapshot
        )
        && data.role == 'leader'
        && data.joinedBy == 'created'
        && data.joinSequence == 1
        && data.displayCharacterIdSnapshot is string
        && data.displayCharacterNameSnapshot is string
        && group.status == 'active'
        && group.leaderPlayerId == playerId
        && group.memberCount == 1
        && group.revision == 1
        && group.representativeCharacterId == data.displayCharacterIdSnapshot
        && group.leaderDisplayCharacterNameSnapshot
          == data.displayCharacterNameSnapshot;
    }

    // 생성과 갱신 모두 이전 상태를 명시적으로 전달해 nullable map을 사용하지 않는다.
    function validMembershipStateAdd(
      playerId,
      docId,
      previousIds,
      previousRevision,
      newData
    ) {
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && docId == 'current'
        && validMembershipStateDocumentKeys(newData)
        && newData.schemaVersion == 1
        && newData.playerId == playerId
        && newData.activeGroupIds is list
        && newData.activeGroupIds.size() == previousIds.size() + 1
        && newData.activeGroupIds.size() > 0
        && validMembershipStateAddMember(
          playerId,
          newData.activeGroupIds[newData.activeGroupIds.size() - 1],
          newData,
          previousIds,
          previousRevision
        );
    }

    function validMembershipStateAddMember(
      playerId,
      addedGroupId,
      newData,
      previousIds,
      previousRevision
    ) {
      let member = getAfter(groupMemberPath(addedGroupId, playerId)).data;
      return newData.activeGroupIds is list
        && newData.activeGroupIds.size() == previousIds.size() + 1
        && newData.activeGroupIds.size() <= 50
        && newData.activeGroupIds.toSet().size()
          == newData.activeGroupIds.size()
        && newData.activeGroupIds.toSet().difference(previousIds.toSet())
          == [addedGroupId].toSet()
        && newData.activeGroupCount == newData.activeGroupIds.size()
        && newData.revision == previousRevision + 1
        && newData.updatedAt == request.time
        && member.playerId == playerId;
    }

    function validInitialMemberGroupRelation(playerId, groupId, data) {
      let group = getAfter(groupPath(groupId)).data;
      let member = getAfter(groupMemberPath(groupId, playerId)).data;
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && data.keys().hasOnly([
          'schemaVersion', 'groupId', 'playerId', 'relation', 'requestStatus',
          'groupNameSnapshot', 'displayCharacterNameSnapshot', 'expiresAt',
          'sourceRevision', 'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.groupId == groupId
        && data.playerId == playerId
        && data.relation == 'member'
        && data.requestStatus == null
        && data.expiresAt == null
        && data.groupNameSnapshot == group.name
        && data.displayCharacterNameSnapshot
          == member.displayCharacterNameSnapshot
        && data.sourceRevision == member.revision
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && member.playerId == playerId;
    }

    // 생성 Transaction은 새 Group ID를 읽지 않는다. 상세 화면이 사라진 ID를 열 때만
    // 존재 여부를 분기해 없는 문서에서 resource.data를 읽지 않는다.
    function canGetGroup(groupId) {
      return hasActiveBinding()
        && (!exists(groupPath(groupId))
          || resource.data.status == 'active'
          || isCurrentGroupMember(groupId));
    }

    // 계약 §6 초대·신청 원본의 허용 필드 집합.
    function validGroupJoinRelationKeys(data) {
      return data.keys().hasOnly([
        'schemaVersion', 'groupId', 'targetPlayerId', 'kind', 'status',
        'requestedByPlayerId', 'characterIdSnapshot', 'characterNameSnapshot',
        'serverNameSnapshot', 'characterClassNameSnapshot', 'itemLevelSnapshot',
        'combatPowerSnapshot', 'gemValidationSnapshot', 'applicationAttempt',
        'revision', 'createdAt', 'expiresAt', 'decidedAt', 'updatedAt'
      ]);
    }

    function validGroupMemberDocumentKeys(data) {
      return data.keys().hasOnly([
        'schemaVersion', 'groupId', 'playerId', 'role', 'joinedAt',
        'joinSequence', 'joinedBy', 'displayCharacterIdSnapshot',
        'displayCharacterNameSnapshot', 'displayClassNameSnapshot',
        'itemLevelSnapshot', 'combatPowerSnapshot', 'gemValidationSnapshot',
        'revision', 'createdAt', 'updatedAt'
      ]);
    }

    function validNewGroupMemberCore(groupId, playerId, data) {
      return validGroupMemberDocumentKeys(data)
        && data.schemaVersion == 1
        && data.groupId == groupId
        && data.playerId == playerId
        && data.revision == 1
        && data.joinedAt == request.time
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validMembershipStateDocumentKeys(data) {
      return data.keys().hasOnly([
        'schemaVersion', 'playerId', 'activeGroupIds', 'activeGroupCount',
        'revision', 'updatedAt'
      ]);
    }

    function validGroupMemberOptionalNumberFields(data) {
      return (data.itemLevelSnapshot == null || data.itemLevelSnapshot is number)
        && (data.combatPowerSnapshot == null
          || data.combatPowerSnapshot is number)
        && (data.gemValidationSnapshot == null
          || data.gemValidationSnapshot is map);
    }

    function validGroupMemberSnapshotsFromRelation(data, relation) {
      return data.displayClassNameSnapshot == relation.characterClassNameSnapshot
        && data.itemLevelSnapshot == relation.itemLevelSnapshot
        && data.combatPowerSnapshot == relation.combatPowerSnapshot
        && validGroupMemberOptionalNumberFields(data);
    }

    function validGroupMemberSnapshotsFromCharacter(data, characterId) {
      let character = get(characterPath(characterId)).data;
      // 표시 Snapshot은 Transaction 시점 클라이언트 값을 저장한다.
      // Firestore Character에는 combatPower가 없을 수 있으므로 class·형식만 검증한다.
      return data.displayClassNameSnapshot == character.characterClassName
        && validGroupMemberOptionalNumberFields(data);
    }

    // 본인 membership 표시 Snapshot만 갱신한다. display Character는 바꿀 수 없다.
    function validGroupMemberSelfSnapshotRefresh(
      groupId,
      playerId,
      oldData,
      newData
    ) {
      let characterId = oldData.displayCharacterIdSnapshot;
      let character = get(characterPath(characterId)).data;
      return isCurrentPlayerActive()
        && playerId == currentPlayerId()
        && exists(groupMemberPath(groupId, playerId))
        && oldData.playerId == playerId
        && oldData.groupId == groupId
        // Preserve required-field rejection for malformed legacy documents.
        // affectedKeys below protects values AND field additions/deletions.
        && oldData.keys().hasAll([
          'schemaVersion', 'groupId', 'playerId', 'role', 'joinedAt',
          'joinSequence', 'joinedBy', 'displayCharacterIdSnapshot',
          'displayCharacterNameSnapshot', 'revision', 'createdAt'
        ])
        && newData.displayClassNameSnapshot == character.characterClassName
        && validGroupMemberOptionalNumberFields(newData)
        && newData.updatedAt == request.time
        && newData.diff(oldData).affectedKeys().hasOnly([
          'displayClassNameSnapshot',
          'itemLevelSnapshot',
          'combatPowerSnapshot',
          'gemValidationSnapshot',
          'updatedAt'
        ]);
    }

    // 같은 groupId + playerId에 유효 pending 관계가 있으면 종류가 달라도
    // 새 요청으로 덮어쓰지 못한다. 만료·최종 relation만 재사용한다.
    function reusableGroupJoinRelation(oldData) {
      return oldData == null
        || oldData.status != 'pending'
        || oldData.expiresAt <= request.time;
    }

    // 계약 §6은 expiresAt == createdAt + 24시간을 요구하지만 클라이언트는 서버
    // 시각을 알 수 없다. createdAt은 request.time으로 고정하고 expiresAt은
    // 기기 시각 오차를 감안한 구간으로만 허용한다.
    function validGroupRequestExpiry(data) {
      return data.expiresAt is timestamp
        && data.expiresAt > request.time + duration.value(23, 'h')
        && data.expiresAt < request.time + duration.value(25, 'h');
    }

    function validGroupPendingJoinRelation(
      groupId,
      playerId,
      previousRevision,
      reusable,
      data
    ) {
      return isCurrentPlayerActive()
        && validGroupJoinRelationKeys(data)
        && data.schemaVersion == 1
        && data.groupId == groupId
        && data.targetPlayerId == playerId
        && data.status == 'pending'
        && data.requestedByPlayerId is string
        && data.characterIdSnapshot is string
        && data.characterNameSnapshot is string
        && data.serverNameSnapshot is string
        && data.characterClassNameSnapshot is string
        && data.applicationAttempt is int
        && data.revision == previousRevision + 1
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.decidedAt == null
        && validGroupRequestExpiry(data)
        && reusable
        && get(groupPath(groupId)).data.status == 'active'
        && !exists(groupMemberPath(groupId, playerId))
        && !hasGroupBlock(groupId, playerId)
        && existsAfter(groupRelationPath(playerId, groupId));
    }

    // 계약 §8.3. 현재 그룹원만 초대하며 자기 자신은 초대하지 못한다.
    // 초대는 누적 신청 횟수를 증가시키지 않는다.
    function validGroupInvitationCreate(
      groupId,
      playerId,
      previousRevision,
      previousApplicationAttempt,
      reusable,
      data
    ) {
      return validGroupPendingJoinRelation(
          groupId,
          playerId,
          previousRevision,
          reusable,
          data
        )
        && data.kind == 'invitation'
        && data.requestedByPlayerId == currentPlayerId()
        && playerId != currentPlayerId()
        && isCurrentGroupMember(groupId)
        && data.applicationAttempt == previousApplicationAttempt;
    }

    // 계약 §8.5. 신청은 본인만 만들고 applicantStats 증가와 함께 성공한다.
    function validGroupApplicationCreate(
      groupId,
      playerId,
      previousRevision,
      reusable,
      data
    ) {
      let stats = getAfter(groupApplicantStatsPath(groupId, playerId)).data;
      return validGroupPendingJoinRelation(
          groupId,
          playerId,
          previousRevision,
          reusable,
          data
        )
        && data.kind == 'application'
        && data.requestedByPlayerId == playerId
        && playerId == currentPlayerId()
        && data.applicationAttempt >= 1
        && data.applicationAttempt == stats.applicationCount;
    }

    // 계약 §8.4. 수락·거절은 대상 Player만, 취소는 발신자 또는 그룹장만 한다.
    // Unit 2는 pending invitation 전이만 열고 신청 승인·거절은 Unit 3에서 연다.
    function validGroupJoinRelationDecision(groupId, playerId, oldData, newData) {
      return isCurrentPlayerActive()
        && newData.diff(oldData).affectedKeys()
          .hasOnly(['status', 'revision', 'decidedAt', 'updatedAt'])
        && oldData.kind == 'invitation'
        && oldData.status == 'pending'
        && newData.revision == oldData.revision + 1
        && newData.decidedAt == request.time
        && newData.updatedAt == request.time
        && existsAfter(groupRelationPath(playerId, groupId))
        && (
          (newData.status == 'accepted'
            && playerId == currentPlayerId()
            && oldData.expiresAt > request.time
            && !hasGroupBlock(groupId, playerId)
            && existsAfter(groupMemberPath(groupId, playerId)))
          || (newData.status == 'rejected'
            && playerId == currentPlayerId())
          || (newData.status == 'cancelled'
            && isCurrentGroupMember(groupId)
            && (oldData.requestedByPlayerId == currentPlayerId()
              || isCurrentGroupLeader(groupId)))
        );
    }

    // 계약 §8.4 초대 수락 membership. joinSequence는 읽은 memberCount + 1이며
    // 그룹 인원 갱신 이후 값과 같아야 한다.
    function validInvitedGroupMember(groupId, playerId, data) {
      let group = getAfter(groupPath(groupId)).data;
      let relation = getAfter(groupJoinRelationPath(groupId, playerId)).data;
      let state = getAfter(groupMembershipStatePath(playerId)).data;
      return isCurrentPlayerActive()
        && playerId == currentPlayerId()
        && validNewGroupMemberCore(groupId, playerId, data)
        && validGroupMemberSnapshotsFromRelation(data, relation)
        && data.role == 'member'
        && data.joinedBy == 'invitation'
        && data.joinSequence == group.memberCount
        && data.displayCharacterIdSnapshot == relation.characterIdSnapshot
        && data.displayCharacterNameSnapshot == relation.characterNameSnapshot
        && group.status == 'active'
        && group.memberCount <= 50
        && group.leaderPlayerId != playerId
        && relation.kind == 'invitation'
        && relation.status == 'accepted'
        && relation.targetPlayerId == playerId
        && !hasGroupBlock(groupId, playerId)
        && groupId in state.activeGroupIds;
    }

    // 계약 §9. Unit 2 상태 변경은 공개 필드를 바꾸지 않고 활동 시각만 갱신한다.
    function validGroupActivityUpdate(oldData, newData) {
      return newData.diff(oldData).affectedKeys()
          .hasOnly(['revision', 'lastActivityAt', 'updatedAt'])
        && newData.revision == oldData.revision + 1
        && newData.lastActivityAt == request.time
        && newData.updatedAt == request.time;
    }

    function validGroupMemberJoinUpdate(groupId, oldData, newData) {
      let memberPath = groupMemberPath(groupId, currentPlayerId());
      return existsAfter(memberPath)
        && newData.diff(oldData).affectedKeys()
          .hasOnly(['memberCount', 'revision', 'lastActivityAt', 'updatedAt'])
        && newData.memberCount == oldData.memberCount + 1
        && newData.memberCount <= 50
        && newData.revision == oldData.revision + 1
        && newData.lastActivityAt == request.time
        && newData.updatedAt == request.time
        && getAfter(memberPath).data.joinSequence == newData.memberCount;
    }

    // Native list difference replaces the unrolled 50-slot search.
    // Guard the index: malformed removals must fail closed.
    function removedActiveGroupId(previousIds, newIds) {
      let removedIds = previousIds.removeAll(newIds);
      return removedIds.size() == 1 ? removedIds[0] : '';
    }


    function validGroupMemberSelfLeaveDelete(groupId, playerId, data) {
      let group = getAfter(groupPath(groupId)).data;
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && data.role == 'member'
        && data.playerId == playerId
        && group.status == 'active'
        && group.memberCount == get(groupPath(groupId)).data.memberCount - 1
        && !existsAfter(groupMemberPath(groupId, playerId))
        && !existsAfter(groupRelationPath(playerId, groupId));
    }

    function validGroupMemberLeaveUpdate(groupId, oldData, newData) {
      return isCurrentPlayerActive()
        && oldData.status == 'active'
        && newData.diff(oldData).affectedKeys()
          .hasOnly(['memberCount', 'revision', 'lastActivityAt', 'updatedAt'])
        && newData.memberCount == oldData.memberCount - 1
        && newData.memberCount >= 1
        && newData.revision == oldData.revision + 1
        && newData.lastActivityAt == request.time
        && newData.updatedAt == request.time
        && !existsAfter(groupMemberPath(groupId, currentPlayerId()));
    }

    function validGroupLeaderTransferUpdate(groupId, oldData, newData) {
      let outgoing = getAfter(groupMemberPath(groupId, currentPlayerId())).data;
      let incoming = getAfter(groupMemberPath(groupId, newData.leaderPlayerId)).data;
      return isCurrentPlayerActive()
        && oldData.status == 'active'
        && oldData.leaderPlayerId == currentPlayerId()
        && newData.leaderPlayerId is string
        && newData.leaderPlayerId != oldData.leaderPlayerId
        && newData.diff(oldData).affectedKeys().hasOnly([
          'leaderPlayerId', 'leaderDisplayCharacterNameSnapshot',
          'revision', 'lastActivityAt', 'updatedAt'
        ])
        && newData.leaderDisplayCharacterNameSnapshot
          == incoming.displayCharacterNameSnapshot
        && newData.revision == oldData.revision + 1
        && newData.lastActivityAt == request.time
        && newData.updatedAt == request.time
        && outgoing.role == 'member'
        && incoming.role == 'leader'
        && incoming.playerId == newData.leaderPlayerId;
    }

    function validGroupMemberRoleTransferUpdate(
      groupId,
      playerId,
      oldData,
      newData
    ) {
      let before = get(groupPath(groupId)).data;
      let after = getAfter(groupPath(groupId)).data;
      return isCurrentPlayerActive()
        && before.status == 'active'
        && before.leaderPlayerId == currentPlayerId()
        && after.leaderPlayerId != before.leaderPlayerId
        && after.status == 'active'
        && newData.diff(oldData).affectedKeys()
          .hasOnly(['role', 'revision', 'updatedAt'])
        && newData.revision == oldData.revision + 1
        && newData.updatedAt == request.time
        && (
          (playerId == currentPlayerId()
            && oldData.role == 'leader'
            && newData.role == 'member')
          || (playerId == after.leaderPlayerId
            && oldData.role == 'member'
            && newData.role == 'leader')
        );
    }

    function validGroupDisbandUpdate(groupId, oldData, newData) {
      return isCurrentPlayerActive()
        && oldData.status == 'active'
        && oldData.leaderPlayerId == currentPlayerId()
        && oldData.memberCount == 1
        && oldData.hasActiveJoinCode == false
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'memberCount', 'deletedAt',
          'revision', 'lastActivityAt', 'updatedAt'
        ])
        && newData.status == 'softDeleted'
        && newData.memberCount == 0
        && newData.deletedAt == request.time
        && newData.revision == oldData.revision + 1
        && newData.lastActivityAt == request.time
        && newData.updatedAt == request.time
        && !existsAfter(groupMemberPath(groupId, currentPlayerId()));
    }

    function validGroupMemberDisbandDelete(groupId, playerId, data) {
      let group = getAfter(groupPath(groupId)).data;
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && data.role == 'leader'
        && data.playerId == playerId
        && group.status == 'softDeleted'
        && group.memberCount == 0
        && group.leaderPlayerId == playerId
        && !existsAfter(groupMemberPath(groupId, playerId))
        && !existsAfter(groupRelationPath(playerId, groupId));
    }

    function validMembershipStateRemove(playerId, docId, oldData, newData) {
      let previousIds = oldData.activeGroupIds;
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && docId == 'current'
        && validMembershipStateDocumentKeys(newData)
        && newData.schemaVersion == 1
        && newData.playerId == playerId
        && newData.activeGroupIds is list
        && newData.activeGroupIds.size() == previousIds.size() - 1
        && previousIds.toSet().difference(newData.activeGroupIds.toSet()).size()
          == 1
        && newData.activeGroupCount == newData.activeGroupIds.size()
        && newData.revision == oldData.revision + 1
        && newData.updatedAt == request.time
        && validRemovedMembershipState(
          playerId,
          previousIds,
          newData.activeGroupIds
        );
    }

    function validRemovedMembershipState(playerId, previousIds, newIds) {
      let removedGroupId = removedActiveGroupId(previousIds, newIds);
      return removedGroupId != ''
        && !existsAfter(groupMemberPath(removedGroupId, playerId))
        && !existsAfter(groupRelationPath(playerId, removedGroupId));
    }

    function validGroupMemberLeaveRelationDelete(playerId, groupId) {
      let group = getAfter(groupPath(groupId)).data;
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && group.status == 'active'
        && group.memberCount == get(groupPath(groupId)).data.memberCount - 1
        && !existsAfter(groupMemberPath(groupId, playerId));
    }

    function validGroupDisbandRelationDelete(playerId, groupId) {
      let group = getAfter(groupPath(groupId)).data;
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && group.status == 'softDeleted'
        && group.memberCount == 0
        && group.leaderPlayerId == playerId
        && !existsAfter(groupMemberPath(groupId, playerId));
    }

    // 초대·신청 명령을 실행할 수 있는 호출자만 그룹 활동 시각을 갱신한다.
    // 그룹원이 아니면 같은 Transaction에서 자기 요청 Projection이 남아야 한다.
    function validGroupJoinCommandUpdate(groupId, oldData, newData) {
      return isCurrentPlayerActive()
        && oldData.status == 'active'
        && (isCurrentGroupMember(groupId)
          || existsAfter(groupRelationPath(currentPlayerId(), groupId)))
        && (validGroupActivityUpdate(oldData, newData)
          || validGroupMemberJoinUpdate(groupId, oldData, newData));
    }

    function validGroupRelationProjectionKeys(data) {
      return data.keys().hasOnly([
        'schemaVersion', 'groupId', 'playerId', 'relation', 'requestStatus',
        'groupNameSnapshot', 'displayCharacterNameSnapshot', 'expiresAt',
        'sourceRevision', 'createdAt', 'updatedAt'
      ]);
    }

    // 계약 §5. 요청 Projection은 원본 join relation과 같은 sourceRevision을 갖는다.
    // 초대는 발신 그룹원이 대상 Player 경로에 쓰므로 본인 확인만으로 제한하지 않는다.
    function validGroupRequestRelation(playerId, groupId, data) {
      let group = getAfter(groupPath(groupId)).data;
      let relation = getAfter(groupJoinRelationPath(groupId, playerId)).data;
      return isCurrentPlayerActive()
        && (playerId == currentPlayerId() || isCurrentGroupMember(groupId))
        && validGroupRelationProjectionKeys(data)
        && data.schemaVersion == 1
        && data.groupId == groupId
        && data.playerId == playerId
        && data.relation
          == (relation.kind == 'invitation' ? 'invited' : 'applied')
        && data.requestStatus == relation.status
        && data.expiresAt == relation.expiresAt
        && data.groupNameSnapshot == group.name
        && data.displayCharacterNameSnapshot == relation.characterNameSnapshot
        && data.sourceRevision == relation.revision
        && data.createdAt is timestamp
        && data.updatedAt == request.time
        && relation.targetPlayerId == playerId;
    }

    // 초대 수락이 끝난 Projection은 member/accepted로 바뀐다.
    function validAcceptedGroupRelation(playerId, groupId, data) {
      let group = getAfter(groupPath(groupId)).data;
      let member = getAfter(groupMemberPath(groupId, playerId)).data;
      let relation = getAfter(groupJoinRelationPath(groupId, playerId)).data;
      return isCurrentPlayerActive()
        && playerId == currentPlayerId()
        && validGroupRelationProjectionKeys(data)
        && data.schemaVersion == 1
        && data.groupId == groupId
        && data.playerId == playerId
        && data.relation == 'member'
        && data.requestStatus == 'accepted'
        && data.expiresAt == null
        && data.groupNameSnapshot == group.name
        && data.displayCharacterNameSnapshot
          == member.displayCharacterNameSnapshot
        && data.sourceRevision == member.revision
        && data.createdAt is timestamp
        && data.updatedAt == request.time
        && (
          (member.joinedBy == 'invitation' && relation.kind == 'invitation')
          || member.joinedBy == 'joinCode'
        )
        && relation.status == 'accepted';
    }

    // 계약 §6.1. 신청 경로에서만 만들고 갱신하며 정확히 1씩 증가시킨다.
    function validGroupApplicantStatsWrite(
      groupId,
      playerId,
      previousApplicationCount,
      previousCreatedAt,
      data
    ) {
      let relation = getAfter(groupJoinRelationPath(groupId, playerId)).data;
      return isCurrentPlayerActive()
        && playerId == currentPlayerId()
        && data.keys().hasOnly([
          'schemaVersion', 'groupId', 'playerId', 'applicationCount',
          'lastCharacterNameSnapshot', 'lastItemLevelSnapshot',
          'lastCombatPowerSnapshot', 'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.groupId == groupId
        && data.playerId == playerId
        && data.applicationCount == previousApplicationCount + 1
        && data.lastCharacterNameSnapshot == relation.characterNameSnapshot
        && data.lastItemLevelSnapshot == relation.itemLevelSnapshot
        && data.lastCombatPowerSnapshot == relation.combatPowerSnapshot
        && data.createdAt == previousCreatedAt
        && data.updatedAt == request.time
        && relation.kind == 'application'
        && relation.status == 'pending'
        && relation.applicationAttempt == data.applicationCount;
    }

    // 계약 §8.6 그룹장 신청 처리(Unit 3).
    //
    // 승인 Transaction은 문서 5건을 쓰므로 쓰기마다 접근 수를 줄여야 한다.
    // 그룹장 판정은 binding·Player·그룹을 한 번씩만 읽는 아래 helper로 모으고,
    // 하위 문서 규칙은 이미 읽은 getAfter 결과를 재사용한다. 그룹 원본 규칙은
    // 자기 문서를 다시 읽지 않고 resource.data로 그룹장을 확인한다.
    //
    // 승인 Transaction 접근 예산: 서로 다른 문서 8개(authBindings, players/{그룹장},
    // groups/{g}, joinRelations/{p}, members/{p}, blockedPlayers/{p},
    // players/{p}/groupMembershipState/current, players/{p}/groupRelations/{g}),
    // get·getAfter를 따로 세면 접근 12회다. 쓰기별 접근 호출은 그룹 5, 요청 8,
    // membership 8, 요약 6, Projection 6으로 단일 쓰기 한도 10 이하다.
    function isActiveGroupLeader(groupId) {
      let callerId = currentPlayerId();
      return hasActiveBinding()
        && get(playerPath(callerId)).data.status == 'active'
        && get(groupPath(groupId)).data.leaderPlayerId == callerId;
    }

    // 승인·거절·금지 전이. 호출자가 대상이 아니므로 초대 전이와 분리해
    // validGroupJoinRelationDecision이 쓰는 초대 경로 접근 수를 늘리지 않는다.
    function validGroupApplicationDecision(groupId, playerId, oldData, newData) {
      return isActiveGroupLeader(groupId)
        && newData.diff(oldData).affectedKeys()
          .hasOnly(['status', 'revision', 'decidedAt', 'updatedAt'])
        && oldData.kind == 'application'
        && oldData.status == 'pending'
        && oldData.targetPlayerId == playerId
        && playerId != currentPlayerId()
        && newData.revision == oldData.revision + 1
        && newData.decidedAt == request.time
        && newData.updatedAt == request.time
        && existsAfter(groupRelationPath(playerId, groupId))
        && (
          (newData.status == 'accepted'
            && oldData.expiresAt > request.time
            && !hasGroupBlock(groupId, playerId)
            && existsAfter(groupMemberPath(groupId, playerId)))
          || newData.status == 'rejected'
          || (newData.status == 'blocked'
            && existsAfter(groupBlockPath(groupId, playerId)))
        );
    }

    // 계약 §8.6 승인은 초대 수락과 같은 membership 원자 쓰기를 수행한다.
    // 그룹장이 대상 Player 문서를 만들므로 joinSequence, 정원, 금지 부재와
    // Player 요약 반영을 모두 getAfter로 다시 확인한다.
    function validApprovedGroupMember(groupId, playerId, data) {
      let callerId = currentPlayerId();
      let group = getAfter(groupPath(groupId)).data;
      let relation = getAfter(groupJoinRelationPath(groupId, playerId)).data;
      let state = getAfter(groupMembershipStatePath(playerId)).data;
      return hasActiveBinding()
        && get(playerPath(callerId)).data.status == 'active'
        && group.leaderPlayerId == callerId
        && playerId != callerId
        && validNewGroupMemberCore(groupId, playerId, data)
        && validGroupMemberSnapshotsFromRelation(data, relation)
        && data.role == 'member'
        && data.joinedBy == 'application'
        && data.joinSequence == group.memberCount
        && data.displayCharacterIdSnapshot == relation.characterIdSnapshot
        && data.displayCharacterNameSnapshot == relation.characterNameSnapshot
        && group.status == 'active'
        && group.memberCount <= 50
        && relation.kind == 'application'
        && relation.status == 'accepted'
        && relation.targetPlayerId == playerId
        && !hasGroupBlock(groupId, playerId)
        && groupId in state.activeGroupIds;
    }

    // 대상 Player 요약은 개인 데이터라 그룹장이 읽지 못한다. 클라이언트는
    // arrayUnion·increment 병합 쓰기를 보내고 Rules가 결과 문서에서 Group ID
    // 정확히 1개 추가와 50개 한도를 최종 판정한다.
    function validLeaderApprovedMembershipStateAdd(
      playerId,
      docId,
      previousIds,
      previousRevision,
      newData
    ) {
      let callerId = currentPlayerId();
      let addedGroupId = newData.activeGroupIds[
        newData.activeGroupIds.size() - 1
      ];
      let member = getAfter(groupMemberPath(addedGroupId, playerId)).data;
      return hasActiveBinding()
        && get(playerPath(callerId)).data.status == 'active'
        && docId == 'current'
        && playerId != callerId
        && validMembershipStateDocumentKeys(newData)
        && newData.schemaVersion == 1
        && newData.playerId == playerId
        && validMembershipStateAddMember(
          playerId,
          addedGroupId,
          newData,
          previousIds,
          previousRevision
        )
        && member.joinedBy == 'application'
        && getAfter(groupPath(addedGroupId)).data.leaderPlayerId == callerId;
    }

    // 승인 이후 대상 Player Projection. 그룹장은 대상 Projection을 읽지 못하므로
    // createdAt은 병합 쓰기로 보존하고 Rules는 timestamp 여부만 확인한다.
    function validLeaderApprovedGroupRelation(playerId, groupId, data) {
      let callerId = currentPlayerId();
      let group = getAfter(groupPath(groupId)).data;
      let member = getAfter(groupMemberPath(groupId, playerId)).data;
      return hasActiveBinding()
        && get(playerPath(callerId)).data.status == 'active'
        && group.leaderPlayerId == callerId
        && playerId != callerId
        && validGroupRelationProjectionKeys(data)
        && data.schemaVersion == 1
        && data.groupId == groupId
        && data.playerId == playerId
        && data.relation == 'member'
        && data.requestStatus == 'accepted'
        && data.expiresAt == null
        && data.groupNameSnapshot == group.name
        && data.displayCharacterNameSnapshot
          == member.displayCharacterNameSnapshot
        && data.sourceRevision == member.revision
        && data.createdAt is timestamp
        && data.updatedAt == request.time
        && member.joinedBy == 'application';
    }

    // 계약 §8.6 승인은 그룹장이 실행하므로 신규 멤버가 호출자가 아니다.
    // 그룹 문서 규칙은 대상 Player ID를 알 수 없어 그룹장·정원·필드 집합만
    // 강제하고, member ↔ memberCount 결합은 membership 쓰기 규칙이 확인한다.
    function validGroupLeaderApproveUpdate(oldData, newData) {
      return isCurrentPlayerActive()
        && oldData.status == 'active'
        && oldData.leaderPlayerId == currentPlayerId()
        && newData.diff(oldData).affectedKeys()
          .hasOnly(['memberCount', 'revision', 'lastActivityAt', 'updatedAt'])
        && newData.memberCount == oldData.memberCount + 1
        && newData.memberCount <= 50
        && newData.revision == oldData.revision + 1
        && newData.lastActivityAt == request.time
        && newData.updatedAt == request.time;
    }

    // 계약 §6.2·§10. block 생성은 대상 relation의 blocked 전이 또는 이미 끝난
    // 신청에만 묶는다. 수정은 열지 않고 해제는 문서 삭제로만 한다.
    function validGroupBlockCreate(groupId, playerId, data) {
      let relation = getAfter(groupJoinRelationPath(groupId, playerId)).data;
      let stats = get(groupApplicantStatsPath(groupId, playerId));
      return isActiveGroupLeader(groupId)
        && playerId != currentPlayerId()
        && data.keys().hasOnly([
          'schemaVersion', 'groupId', 'playerId', 'blockedByPlayerId', 'reason',
          'characterNameSnapshot', 'applicationCountSnapshot',
          'itemLevelSnapshot', 'combatPowerSnapshot', 'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.groupId == groupId
        && data.playerId == playerId
        && data.blockedByPlayerId == currentPlayerId()
        && data.characterNameSnapshot == relation.characterNameSnapshot
        && data.itemLevelSnapshot == relation.itemLevelSnapshot
        && data.combatPowerSnapshot == relation.combatPowerSnapshot
        && data.applicationCountSnapshot
          == (stats == null ? 0 : stats.data.applicationCount)
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && relation.targetPlayerId == playerId
        && relation.kind == 'application'
        && (
          (data.reason == 'applicationRejected'
            && relation.status == 'blocked')
          || (data.reason == 'manual'
            && relation.status in ['rejected', 'cancelled', 'expired', 'blocked'])
        );
    }

    // 계약 §7 초대코드(Unit 4).
    //
    // 코드 생성 접근 예산: authBindings, players/{리더}, groups/{g},
    // members/{리더}, groupJoinCodes/{code} → get·getAfter 합계 약 8회.
    // 코드 가입 접근 예산: authBindings, players/{가입자}, groupJoinCodes/{code},
    // groups/{g}, groupMembershipState, characters/{c}, joinRelations/{선택},
    // blockedPlayers exists, members getAfter, groupRelations getAfter →
    // 서로 다른 문서 ≤10, get·getAfter 합계 약 16회(한도 ~20 이하).
    function validJoinCodeId(code) {
      return code is string
        && code.matches('^([2-9A-HJ-NP-Z]{6}|[2-9A-HJ-NP-Z]{20})$');
    }

    function validJoinCodeCreate(code, data) {
      let groupId = data.groupId;
      let before = get(groupPath(groupId)).data;
      let after = getAfter(groupPath(groupId)).data;
      return isActiveGroupLeader(groupId)
        && validJoinCodeId(code)
        && data.keys().hasOnly([
          'schemaVersion', 'groupId', 'status', 'createdByPlayerId',
          'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.groupId is string
        && data.groupId.size() > 0
        && data.status == 'active'
        && data.createdByPlayerId == currentPlayerId()
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && before.hasActiveJoinCode == false
        && after.hasActiveJoinCode == true
        && after.activeJoinCode == code
        && after.revision == before.revision + 1;
    }

    function validJoinCodeDelete(code) {
      let data = resource.data;
      let groupId = data.groupId;
      let before = get(groupPath(groupId)).data;
      let after = getAfter(groupPath(groupId)).data;
      return isActiveGroupLeader(groupId)
        && validJoinCodeId(code)
        && data.status == 'active'
        && before.hasActiveJoinCode == true
        && after.hasActiveJoinCode == false
        && before.activeJoinCode == code
        && after.activeJoinCode == null
        && after.revision == before.revision + 1;
    }

    // 코드 생성·삭제가 같은 Transaction에서 hasActiveJoinCode만 뒤집는다.
    function validGroupJoinCodeFlagUpdate(oldData, newData) {
      return isCurrentPlayerActive()
        && oldData.status == 'active'
        && oldData.leaderPlayerId == currentPlayerId()
        && newData.diff(oldData).affectedKeys()
          .hasOnly([
            'hasActiveJoinCode', 'activeJoinCode', 'revision', 'lastActivityAt', 'updatedAt'
          ])
        && newData.hasActiveJoinCode != oldData.hasActiveJoinCode
        && (
          (newData.hasActiveJoinCode == true
            && validJoinCodeId(newData.activeJoinCode))
          || (newData.hasActiveJoinCode == false
            && newData.activeJoinCode == null)
        )
        && newData.revision == oldData.revision + 1
        && newData.lastActivityAt == request.time
        && newData.updatedAt == request.time;
    }

    // 화면 공개 정책만 바꾸며 가입 가능 여부는 건드리지 않는다.
    function validGroupJoinCodeVisibilityUpdate(oldData, newData) {
      return isCurrentPlayerActive()
        && oldData.status == 'active'
        && oldData.leaderPlayerId == currentPlayerId()
        && newData.diff(oldData).affectedKeys()
          .hasOnly([
            'joinCodeVisibleToMembers', 'revision', 'lastActivityAt', 'updatedAt'
          ])
        && newData.joinCodeVisibleToMembers is bool
        && newData.joinCodeVisibleToMembers != oldData.joinCodeVisibleToMembers
        && newData.revision == oldData.revision + 1
        && newData.lastActivityAt == request.time
        && newData.updatedAt == request.time;
    }

    // 계약 §8.7. 코드 가입 membership. Character Snapshot은 선택한 인증
    // Character에서 오며, pending relation이 남으면 안 된다.
    function validJoinCodeGroupMember(groupId, playerId, data) {
      let group = getAfter(groupPath(groupId)).data;
      let state = getAfter(groupMembershipStatePath(playerId)).data;
      let relationPath = groupJoinRelationPath(groupId, playerId);
      return isCurrentPlayerActive()
        && playerId == currentPlayerId()
        && validNewGroupMemberCore(groupId, playerId, data)
        && validGroupMemberSnapshotsFromCharacter(
          data,
          data.displayCharacterIdSnapshot
        )
        && data.role == 'member'
        && data.joinedBy == 'joinCode'
        && data.joinSequence == group.memberCount
        && data.displayCharacterIdSnapshot is string
        && data.displayCharacterNameSnapshot is string
        && ownsActiveCharacter(data.displayCharacterIdSnapshot)
        && get(characterPath(data.displayCharacterIdSnapshot))
          .data.characterName == data.displayCharacterNameSnapshot
        && group.status == 'active'
        && group.memberCount <= 50
        && group.leaderPlayerId != playerId
        && !hasGroupBlock(groupId, playerId)
        && groupId in state.activeGroupIds
        && (
          !existsAfter(relationPath)
          || getAfter(relationPath).data.status != 'pending'
        );
    }

    // 코드 가입이 기존 pending 초대·신청을 accepted로 종료한다.
    // applicantStats는 이 경로에서 쓰지 않는다.
    function validJoinCodeRelationAccept(groupId, playerId, oldData, newData) {
      return isCurrentPlayerActive()
        && playerId == currentPlayerId()
        && newData.diff(oldData).affectedKeys()
          .hasOnly(['status', 'revision', 'decidedAt', 'updatedAt'])
        && oldData.status == 'pending'
        && oldData.targetPlayerId == playerId
        && oldData.expiresAt > request.time
        && newData.status == 'accepted'
        && newData.revision == oldData.revision + 1
        && newData.decidedAt == request.time
        && newData.updatedAt == request.time
        && !hasGroupBlock(groupId, playerId)
        && existsAfter(groupMemberPath(groupId, playerId))
        && getAfter(groupMemberPath(groupId, playerId)).data.joinedBy
          == 'joinCode';
    }

    // pending 없이 코드로만 가입한 Projection. createdAt은 기존 요청
    // Projection을 덮어쓸 때 병합·보존될 수 있다.
    function validJoinCodeMemberGroupRelation(playerId, groupId, data) {
      let group = getAfter(groupPath(groupId)).data;
      let member = getAfter(groupMemberPath(groupId, playerId)).data;
      let relationPath = groupJoinRelationPath(groupId, playerId);
      return isCurrentPlayerActive()
        && playerId == currentPlayerId()
        && validGroupRelationProjectionKeys(data)
        && data.schemaVersion == 1
        && data.groupId == groupId
        && data.playerId == playerId
        && data.relation == 'member'
        && data.requestStatus == null
        && data.expiresAt == null
        && data.groupNameSnapshot == group.name
        && data.displayCharacterNameSnapshot
          == member.displayCharacterNameSnapshot
        && data.sourceRevision == member.revision
        && data.createdAt is timestamp
        && data.updatedAt == request.time
        && member.joinedBy == 'joinCode'
        && (
          !existsAfter(relationPath)
          || getAfter(relationPath).data.status != 'pending'
        );
    }

    function canApproveApplications(recruitmentId) {
      let recruitment = get(recruitmentPath(recruitmentId)).data;
      let playerId = currentPlayerId();
      return recruitment.leaderPlayerId == playerId
        || (exists(recruitmentMemberPath(recruitmentId, playerId))
          && get(recruitmentMemberPath(recruitmentId, playerId))
            .data.canApproveApplications == true);
    }

    function canAccessRecruitmentByAudience(data) {
      return data.visibility == 'public'
        || (data.visibility == 'group'
          && data.groupId is string
          && exists(groupMemberPath(data.groupId, currentPlayerId())));
    }

    function validInitialRecruitment(recruitmentId, data) {
      let playerId = currentPlayerId();
      let member = getAfter(recruitmentMemberPath(recruitmentId, playerId)).data;
      let assignmentId = member.characterId + '_' + data.raidId;
      return hasActiveBinding()
        && data.schemaVersion == 1
        && data.leaderPlayerId == playerId
        && data.memberPlayerIds == [playerId]
        && data.memberCount == 1
        && data.maxMemberCount >= 1
        && data.dealerCount + data.supportCount == 1
        && data.status == 'active'
        && (
          (data.groupId == null && data.visibility == 'public')
          || (data.groupId is string
            && data.visibility in ['public', 'group']
            && exists(groupMemberPath(data.groupId, playerId))
            && get(groupPath(data.groupId)).data.status == 'active')
        )
        && data.currentCycleKey == data.targetCycleKey
        && data.currentCycleStatus == 'active'
        && data.cycleEndsAt == data.cycleStartedAt + duration.value(7, 'd')
        && request.time >= data.cycleStartedAt
        && request.time < data.cycleEndsAt
        && data.revision == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.leaderCharacterNameSnapshot == member.characterNameSnapshot
        && data.leaderClassNameSnapshot == member.classNameSnapshot
        && member.playerId == playerId
        && member.joinedBy == playerId
        && member.partyIndex == 0
        && member.slotIndex == 0
        && getAfter(recruitmentSlotPath(recruitmentId, 0, 0)).data.playerId
          == playerId
        && member.canApproveApplications == true
        && ownsActiveCharacter(member.characterId)
        && getAfter(assignmentPath(playerId, assignmentId)).data.recruitmentId
          == recruitmentId;
    }

    function validInitialLeaderMembership(recruitmentId, playerId, data) {
      let recruitment = getAfter(recruitmentPath(recruitmentId)).data;
      let assignmentId = data.characterId + '_' + recruitment.raidId;
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && data.schemaVersion == 1
        && data.playerId == playerId
        && data.joinedBy == playerId
        && data.partyIndex == 0
        && data.slotIndex == 0
        && data.canApproveApplications == true
        && data.joinedAt == request.time
        && data.updatedAt == request.time
        && recruitment.leaderPlayerId == playerId
        && recruitment.memberPlayerIds == [playerId]
        && ownsActiveCharacter(data.characterId)
        && getAfter(assignmentPath(playerId, assignmentId)).data.recruitmentId
          == recruitmentId;
    }

    function validInitialAssignment(playerId, assignmentId, data) {
      let recruitment = getAfter(recruitmentPath(data.recruitmentId)).data;
      let member = getAfter(
        recruitmentMemberPath(data.recruitmentId, playerId)
      ).data;
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && data.schemaVersion == 1
        && data.playerId == playerId
        && assignmentId == data.characterId + '_' + data.raidId
        && data.cycleKey == recruitment.currentCycleKey
        && data.raidId == recruitment.raidId
        && data.characterId == member.characterId
        && data.role == member.role
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && recruitment.leaderPlayerId == playerId
        && ownsActiveCharacter(data.characterId)
        && !hasWeeklyRaidClaimAfter(
          playerId,
          data.cycleKey,
          data.characterId,
          data.raidId
        );
    }

    function validCycleAdvanceAssignmentCreate(playerId, assignmentId, data) {
      let before = get(recruitmentPath(data.recruitmentId)).data;
      let after = getAfter(recruitmentPath(data.recruitmentId)).data;
      let member = getAfter(
        recruitmentMemberPath(data.recruitmentId, playerId)
      ).data;
      return hasActiveBinding()
        && currentPlayerId() in before.memberPlayerIds
        && playerId in before.memberPlayerIds
        && before.status == 'active'
        && before.continueTogether == true
        && request.time >= before.cycleEndsAt
        && after.status == 'active'
        && after.currentCycleStatus == 'active'
        && after.currentCycleKey != before.currentCycleKey
        && data.schemaVersion == 1
        && data.playerId == playerId
        && assignmentId == data.characterId + '_' + data.raidId
        && data.cycleKey == after.currentCycleKey
        && data.raidId == before.raidId
        && data.characterId == member.characterId
        && data.role == member.role
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && !hasWeeklyRaidClaimAfter(
          playerId,
          data.cycleKey,
          data.characterId,
          data.raidId
        );
    }

    function validJoinedMembership(recruitmentId, playerId, data) {
      let before = get(recruitmentPath(recruitmentId)).data;
      let after = getAfter(recruitmentPath(recruitmentId)).data;
      let assignmentId = data.characterId + '_' + after.raidId;
      let directJoin = playerId == currentPlayerId()
        && before.approvalPolicy.mode == 'directJoin'
        && data.joinedBy == playerId;
      let approvedJoin = canApproveApplications(recruitmentId)
        && data.joinedBy == currentPlayerId();
      return hasActiveBinding()
        && data.schemaVersion == 1
        && data.playerId == playerId
        && data.partyIndex >= 0
        && data.partyIndex < after.partyCount
        && data.slotIndex >= 0
        && data.slotIndex < after.membersPerParty
        && (after.get('slotLedgerVersion', 0) != 1
          || getAfter(recruitmentSlotPath(
            recruitmentId,
            data.partyIndex,
            data.slotIndex
          )).data.playerId == playerId)
        && data.canApproveApplications == false
        && data.joinedAt == request.time
        && data.updatedAt == request.time
        && ownsActiveCharacterForPlayer(data.characterId, playerId)
        && !(playerId in before.memberPlayerIds)
        && playerId in after.memberPlayerIds
        && (directJoin || approvedJoin)
        && (before.visibility == 'public'
          || (before.visibility == 'group'
            && before.groupId is string
            && (isCurrentGroupMember(before.groupId) || approvedJoin)))
        && (after.get('slotLedgerVersion', 0) != 1
          || validPartyCompositionForMember(recruitmentId, data))
        && getAfter(assignmentPath(playerId, assignmentId)).data.recruitmentId
          == recruitmentId;
    }

    function validJoinedAssignment(playerId, assignmentId, data) {
      let recruitment = getAfter(recruitmentPath(data.recruitmentId)).data;
      let member = getAfter(recruitmentMemberPath(data.recruitmentId, playerId)).data;
      return hasActiveBinding()
        && data.schemaVersion == 1
        && data.playerId == playerId
        && assignmentId == data.characterId + '_' + data.raidId
        && data.cycleKey == recruitment.targetCycleKey
        && data.raidId == recruitment.raidId
        && data.characterId == member.characterId
        && data.role == member.role
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && ownsActiveCharacterForPlayer(data.characterId, playerId)
        && playerId in recruitment.memberPlayerIds
        && (playerId == currentPlayerId()
          || canApproveApplications(data.recruitmentId))
        && !hasWeeklyRaidClaimAfter(
          playerId,
          data.cycleKey,
          data.characterId,
          data.raidId
        );
    }

    function validRecruitmentJoin(oldData, newData) {
      let added = newData.memberPlayerIds.toSet().difference(
        oldData.memberPlayerIds.toSet()
      );
      return hasActiveBinding()
        && oldData.status == 'active'
        && oldData.manualRecruitmentEnabled == true
        && oldData.hasAvailableSlot == true
        && newData.diff(oldData).affectedKeys().hasOnly([
          'memberPlayerIds', 'memberCount', 'dealerCount', 'supportCount',
          'hasAvailableSlot', 'revision', 'updatedAt'
        ])
        && added.size() == 1
        && newData.memberPlayerIds.size() == oldData.memberPlayerIds.size() + 1
        && newData.memberCount == oldData.memberCount + 1
        && newData.dealerCount + newData.supportCount
          == oldData.dealerCount + oldData.supportCount + 1
        && newData.memberCount == newData.dealerCount + newData.supportCount
        && newData.memberCount <= newData.maxMemberCount
        && newData.hasAvailableSlot
          == (newData.memberCount < newData.maxMemberCount)
        && newData.revision == oldData.revision + 1
        && newData.updatedAt == request.time;
    }

    function validMembershipRevisionUpdate(recruitmentId, oldData, newData) {
      let playerId = currentPlayerId();
      let memberPath = recruitmentMemberPath(recruitmentId, playerId);
      let memberBefore = get(memberPath);
      let memberAfter = getAfter(memberPath);
      let keys = newData.diff(oldData).affectedKeys();
      let allowedUpdate = keys.hasOnly([
        'revision', 'updatedAt',
        'leaderCharacterNameSnapshot', 'leaderClassNameSnapshot',
        'dealerCount', 'supportCount'
      ]);
      return hasActiveBinding()
        && oldData.status == 'active'
        && playerId in oldData.memberPlayerIds
        && allowedUpdate
        && exists(memberPath)
        && existsAfter(memberPath)
        && (memberBefore.data.characterId != memberAfter.data.characterId
          || memberBefore.data.role != memberAfter.data.role)
        && newData.dealerCount == oldData.dealerCount
          + (memberAfter.data.role == 'dealer' ? 1 : 0)
          - (memberBefore.data.role == 'dealer' ? 1 : 0)
        && newData.supportCount == oldData.supportCount
          + (memberAfter.data.role == 'support' ? 1 : 0)
          - (memberBefore.data.role == 'support' ? 1 : 0)
        && newData.memberCount
          == newData.dealerCount + newData.supportCount
        && newData.supportCount
          <= newData.partyCount * newData.supportsPerParty
        && newData.dealerCount
          <= newData.partyCount
            * (newData.membersPerParty - newData.supportsPerParty)
        && (oldData.leaderPlayerId != playerId
          || (newData.leaderCharacterNameSnapshot
            == memberAfter.data.characterNameSnapshot
            && newData.leaderClassNameSnapshot
              == memberAfter.data.classNameSnapshot))
        && newData.revision == oldData.revision + 1
        && newData.updatedAt == request.time;
    }

    function validPositionRevisionUpdate(oldData, newData) {
      return hasActiveBinding()
        && oldData.status == 'active'
        && oldData.leaderPlayerId == currentPlayerId()
        && oldData.slotLedgerVersion == 1
        && newData.diff(oldData).affectedKeys().hasOnly([
          'revision', 'updatedAt'
        ])
        && newData.revision == oldData.revision + 1
        && newData.updatedAt == request.time;
    }

    function validRecruitmentMemberRemoval(recruitmentId, oldData, newData) {
      let playerId = currentPlayerId();
      let removed = oldData.memberPlayerIds.toSet().difference(
        newData.memberPlayerIds.toSet()
      );
      let actorIsLeader = oldData.leaderPlayerId == playerId;
      let selfLeave = removed.hasAny([playerId]);
      let empty = newData.memberCount == 0;
      let lostQualificationTarget = removedMemberId(
        oldData.memberPlayerIds,
        newData.memberPlayerIds
      );
      let lostQualificationCleanup = !selfLeave
        && lostQualificationTarget.size() > 0
        && isLostGroupQualificationCleanup(
          oldData,
          playerId,
          lostQualificationTarget
        );
      return hasActiveBinding()
        && oldData.status == 'active'
        && removed.size() == 1
        && newData.memberPlayerIds.size() == oldData.memberPlayerIds.size() - 1
        && (selfLeave || (actorIsLeader && !selfLeave) || lostQualificationCleanup)
        && newData.diff(oldData).affectedKeys().hasOnly([
          'memberPlayerIds', 'memberCount', 'dealerCount', 'supportCount',
          'leaderPlayerId', 'leaderCharacterNameSnapshot',
          'leaderClassNameSnapshot', 'hasAvailableSlot', 'status',
          'manualRecruitmentEnabled', 'revision', 'updatedAt'
        ])
        && newData.memberCount == oldData.memberCount - 1
        && ((newData.dealerCount == oldData.dealerCount - 1
            && newData.supportCount == oldData.supportCount)
          || (newData.supportCount == oldData.supportCount - 1
            && newData.dealerCount == oldData.dealerCount))
        && newData.revision == oldData.revision + 1
        && newData.updatedAt == request.time
        && (empty
          ? (newData.leaderPlayerId == null
            && newData.leaderCharacterNameSnapshot == null
            && newData.leaderClassNameSnapshot == null
            && newData.status == 'disbanded'
            && newData.manualRecruitmentEnabled == false
            && newData.hasAvailableSlot == false)
          : (newData.status == oldData.status
            && newData.manualRecruitmentEnabled
              == oldData.manualRecruitmentEnabled
            && newData.hasAvailableSlot == true
            && newData.leaderPlayerId
              == (!(oldData.leaderPlayerId in newData.memberPlayerIds)
                ? newData.memberPlayerIds[0]
                : oldData.leaderPlayerId)
            && newData.leaderCharacterNameSnapshot
              == get(recruitmentMemberPath(
                recruitmentId,
                newData.leaderPlayerId
              )).data.characterNameSnapshot
            && newData.leaderClassNameSnapshot
              == get(recruitmentMemberPath(
                recruitmentId,
                newData.leaderPlayerId
              )).data.classNameSnapshot));
    }

    function validRecurrenceChange(oldData, newData) {
      return hasActiveBinding()
        && oldData.leaderPlayerId == currentPlayerId()
        && oldData.status == 'active'
        && (oldData.currentCycleStatus == 'active'
          || oldData.currentCycleStatus == 'completed')
        && newData.diff(oldData).affectedKeys().hasOnly([
          'continueTogether', 'revision', 'updatedAt'
        ])
        && newData.continueTogether is bool
        && newData.revision == oldData.revision + 1
        && newData.updatedAt == request.time;
    }

    function validRecruitmentDisband(oldData, newData) {
      return hasActiveBinding()
        && oldData.leaderPlayerId == currentPlayerId()
        && (oldData.status == 'active' || oldData.status == 'completed')
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'currentCycleStatus', 'manualRecruitmentEnabled',
          'hasAvailableSlot', 'memberPlayerIds', 'memberCount',
          'dealerCount', 'supportCount', 'leaderPlayerId',
          'leaderCharacterNameSnapshot', 'leaderClassNameSnapshot',
          'revision', 'updatedAt'
        ])
        && newData.status == 'disbanded'
        && newData.currentCycleStatus == 'disbanded'
        && newData.manualRecruitmentEnabled == false
        && newData.hasAvailableSlot == false
        && newData.memberPlayerIds.size() == 0
        && newData.memberCount == 0
        && newData.dealerCount == 0
        && newData.supportCount == 0
        && newData.leaderPlayerId == null
        && newData.leaderCharacterNameSnapshot == null
        && newData.leaderClassNameSnapshot == null
        && newData.revision == oldData.revision + 1
        && newData.updatedAt == request.time;
    }

    function validRecruitmentVisibilityChange(oldData, newData) {
      return hasActiveBinding()
        && oldData.leaderPlayerId == currentPlayerId()
        && oldData.status == 'active'
        && oldData.groupId is string
        && newData.groupId == oldData.groupId
        && newData.diff(oldData).affectedKeys().hasOnly([
          'visibility', 'revision', 'updatedAt'
        ])
        && oldData.visibility in ['public', 'group']
        && newData.visibility in ['public', 'group']
        && oldData.visibility != newData.visibility
        && newData.revision == oldData.revision + 1
        && newData.updatedAt == request.time;
    }

    function validGroupRaidListingDelete(groupId, recruitmentId) {
      let after = getAfter(recruitmentPath(recruitmentId)).data;
      let beforeLeader = exists(recruitmentPath(recruitmentId))
        ? get(recruitmentPath(recruitmentId)).data.leaderPlayerId
        : after.leaderPlayerId;
      let publicToggle = after.visibility == 'public'
        && after.leaderPlayerId == currentPlayerId();
      let disbanded = after.status == 'disbanded'
        || after.currentCycleStatus == 'disbanded';
      return hasActiveBinding()
        && after.groupId == groupId
        && after.updatedAt == request.time
        && (publicToggle || (disbanded && beforeLeader == currentPlayerId()));
    }

    function validCycleCompletion(recruitmentId, oldData, newData) {
      let cycle = getAfter(recruitmentCyclePath(
        recruitmentId,
        oldData.currentCycleKey
      )).data;
      let repeating = oldData.continueTogether == true;
      return hasActiveBinding()
        && oldData.leaderPlayerId == currentPlayerId()
        && oldData.status == 'active'
        && oldData.currentCycleStatus == 'active'
        && request.time < oldData.cycleEndsAt
        && cycle.status == 'completed'
        && cycle.memberPlayerIds == oldData.memberPlayerIds
        && cycle.completedByPlayerId == currentPlayerId()
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'currentCycleStatus', 'manualRecruitmentEnabled',
          'completedAt', 'completedByPlayerId', 'revision', 'updatedAt'
        ])
        && newData.status == (repeating ? 'active' : 'completed')
        && newData.currentCycleStatus == 'completed'
        && newData.manualRecruitmentEnabled == repeating
        && newData.completedAt == request.time
        && newData.completedByPlayerId == currentPlayerId()
        && newData.revision == oldData.revision + 1
        && newData.updatedAt == request.time;
    }

    function validCompletionCancellation(recruitmentId, oldData, newData) {
      let cycle = getAfter(recruitmentCyclePath(
        recruitmentId,
        oldData.currentCycleKey
      )).data;
      return hasActiveBinding()
        && oldData.leaderPlayerId == currentPlayerId()
        && oldData.continueTogether == true
        && oldData.status == 'active'
        && oldData.currentCycleStatus == 'completed'
        && request.time < oldData.cycleEndsAt - duration.value(8, 'h')
        && cycle.status == 'completionCancelled'
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'currentCycleStatus', 'manualRecruitmentEnabled',
          'hasAvailableSlot', 'completedAt', 'completedByPlayerId',
          'revision', 'updatedAt'
        ])
        && newData.status == 'active'
        && newData.currentCycleStatus == 'active'
        && newData.manualRecruitmentEnabled == true
        && newData.hasAvailableSlot
          == (newData.memberCount < newData.maxMemberCount)
        && newData.completedAt == null
        && newData.completedByPlayerId == null
        && newData.revision == oldData.revision + 1
        && newData.updatedAt == request.time;
    }

    function validCycleAdvance(recruitmentId, oldData, newData) {
      let cycle = getAfter(recruitmentCyclePath(
        recruitmentId,
        oldData.currentCycleKey
      )).data;
      let repeating = oldData.continueTogether == true;
      return hasActiveBinding()
        && currentPlayerId() in oldData.memberPlayerIds
        && oldData.status == 'active'
        && request.time >= oldData.cycleEndsAt
        && (cycle.status == 'completed'
          || (cycle.status == 'incompleteEnded'
            && cycle.memberPlayerIds == oldData.memberPlayerIds))
        && newData.revision == oldData.revision + 1
        && newData.updatedAt == request.time
        && (repeating
          ? (newData.diff(oldData).affectedKeys().hasOnly([
              'status', 'currentCycleStatus', 'currentCycleKey',
              'targetCycleKey', 'cycleStartedAt', 'cycleEndsAt',
              'completedAt', 'completedByPlayerId', 'hasAvailableSlot',
              'revision', 'updatedAt'
            ])
            && newData.status == 'active'
            && newData.currentCycleStatus == 'active'
            && newData.currentCycleKey == newData.targetCycleKey
            && newData.cycleStartedAt >= oldData.cycleEndsAt
            && newData.cycleEndsAt
              == newData.cycleStartedAt + duration.value(7, 'd')
            && request.time >= newData.cycleStartedAt
            && request.time < newData.cycleEndsAt
            && newData.completedAt == null
            && newData.completedByPlayerId == null
            && newData.hasAvailableSlot
              == (newData.memberCount < newData.maxMemberCount))
          : (newData.diff(oldData).affectedKeys().hasOnly([
              'status', 'currentCycleStatus', 'manualRecruitmentEnabled',
              'hasAvailableSlot', 'revision', 'updatedAt'
            ])
            && newData.status == 'incompleteEnded'
            && newData.currentCycleStatus == 'incompleteEnded'
            && newData.manualRecruitmentEnabled == false
            && newData.hasAvailableSlot == false));
    }

    function validInitialCycle(recruitmentId, cycleKey, data) {
      let before = get(recruitmentPath(recruitmentId)).data;
      let after = getAfter(recruitmentPath(recruitmentId)).data;
      return hasActiveBinding()
        && currentPlayerId() in before.memberPlayerIds
        && data.schemaVersion == 1
        && data.recruitmentId == recruitmentId
        && data.cycleKey == cycleKey
        && cycleKey == before.currentCycleKey
        && data.memberPlayerIds == before.memberPlayerIds
        && data.completedMemberSnapshot.size() == before.memberCount
        && data.completionRevision == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && ((data.status == 'completed'
            && before.leaderPlayerId == currentPlayerId()
            && request.time < before.cycleEndsAt
            && data.completedAt == request.time
            && data.completedByPlayerId == currentPlayerId()
            && after.currentCycleStatus == 'completed')
          || (data.status == 'incompleteEnded'
            && currentPlayerId() in before.memberPlayerIds
            && request.time >= before.cycleEndsAt
            && data.completedAt == null
            && data.completedByPlayerId == null));
    }

    function validCycleCancellation(recruitmentId, oldData, newData) {
      let recruitment = get(recruitmentPath(recruitmentId)).data;
      return hasActiveBinding()
        && recruitment.leaderPlayerId == currentPlayerId()
        && recruitment.continueTogether == true
        && request.time < recruitment.cycleEndsAt - duration.value(8, 'h')
        && oldData.status == 'completed'
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'completionRevision', 'updatedAt'
        ])
        && newData.status == 'completionCancelled'
        && int(newData.completionRevision) == int(oldData.completionRevision) + 1
        && newData.updatedAt == request.time;
    }

    function validCycleRecompletion(recruitmentId, oldData, newData) {
      let recruitment = get(recruitmentPath(recruitmentId)).data;
      let recruitmentAfter = getAfter(recruitmentPath(recruitmentId)).data;
      return hasActiveBinding()
        && recruitment.leaderPlayerId == currentPlayerId()
        && oldData.status == 'completionCancelled'
        && request.time < recruitment.cycleEndsAt
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'completedAt', 'completedByPlayerId',
          'completionRevision', 'memberPlayerIds',
          'completedMemberSnapshot', 'updatedAt'
        ])
        && newData.status == 'completed'
        && newData.completedAt == request.time
        && newData.completedByPlayerId == currentPlayerId()
        && int(newData.completionRevision) == int(oldData.completionRevision) + 1
        && newData.memberPlayerIds == recruitment.memberPlayerIds
        && newData.completedMemberSnapshot.size() == recruitment.memberCount
        && newData.updatedAt == request.time
        && recruitmentAfter.currentCycleStatus == 'completed';
    }

    function validCancelledCycleEnd(recruitmentId, oldData, newData) {
      let recruitment = get(recruitmentPath(recruitmentId)).data;
      return hasActiveBinding()
        && currentPlayerId() in recruitment.memberPlayerIds
        && oldData.status == 'completionCancelled'
        && request.time >= recruitment.cycleEndsAt
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'completedAt', 'completedByPlayerId',
          'completionRevision', 'memberPlayerIds',
          'completedMemberSnapshot', 'updatedAt'
        ])
        && newData.status == 'incompleteEnded'
        && newData.completedAt == null
        && newData.completedByPlayerId == null
        && newData.completionRevision == oldData.completionRevision + 1
        && newData.memberPlayerIds == recruitment.memberPlayerIds
        && newData.completedMemberSnapshot.size() == recruitment.memberCount
        && newData.updatedAt == request.time;
    }

    function validMemberCharacterChange(recruitmentId, playerId, oldData, newData) {
      let recruitment = getAfter(recruitmentPath(recruitmentId)).data;
      let oldAssignmentId = oldData.characterId + '_' + recruitment.raidId;
      let newAssignmentId = newData.characterId + '_' + recruitment.raidId;
      // 반복 완료 후: 다음 회차 준비 membership만 변경. Claim·새 assignment는 유지/생성하지 않는다.
      let nextWeekPrep = recruitment.status == 'active'
        && recruitment.continueTogether == true
        && recruitment.currentCycleStatus == 'completed';
      let locationUnchanged = newData.partyIndex == oldData.partyIndex
        && newData.get('slotIndex', -1) == oldData.get('slotIndex', -1);
      let locationMoved = recruitment.slotLedgerVersion == 1
        && newData.partyIndex >= 0
        && newData.partyIndex < recruitment.partyCount
        && newData.slotIndex >= 0
        && newData.slotIndex < recruitment.membersPerParty
        && !existsAfter(recruitmentSlotPath(
          recruitmentId,
          oldData.partyIndex,
          oldData.slotIndex
        ))
        && getAfter(recruitmentSlotPath(
          recruitmentId,
          newData.partyIndex,
          newData.slotIndex
        )).data.playerId == playerId;
      let membershipFieldsOk = hasActiveBinding()
        && playerId == currentPlayerId()
        && newData.diff(oldData).affectedKeys().hasOnly([
          'characterId', 'characterNameSnapshot', 'classNameSnapshot',
          'itemLevelSnapshot', 'combatPowerSnapshot', 'gemValidationSnapshot',
          'buildIntegritySnapshot',
          'role', 'partyIndex', 'slotIndex', 'characterChangedAt', 'updatedAt'
        ])
        && (newData.characterId != oldData.characterId
          || newData.role != oldData.role)
        && newData.role in ['dealer', 'support']
        && (locationUnchanged || locationMoved)
        && (locationUnchanged
          || validPartyCompositionForMember(recruitmentId, newData))
        && newData.canApproveApplications == oldData.canApproveApplications
        && ownsActiveCharacter(newData.characterId)
        && newData.characterChangedAt == request.time
        && newData.updatedAt == request.time;
      let activeAssignmentChange = oldAssignmentId == newAssignmentId
        ? (existsAfter(assignmentPath(playerId, newAssignmentId))
          && getAfter(assignmentPath(playerId, newAssignmentId)).data.role
            == newData.role)
        : (!existsAfter(assignmentPath(playerId, oldAssignmentId))
          && getAfter(assignmentPath(playerId, newAssignmentId)).data.characterId
            == newData.characterId
          && getAfter(assignmentPath(playerId, newAssignmentId)).data.role
            == newData.role);
      let nextWeekPrepAssignmentOk =
        !existsAfter(assignmentPath(playerId, oldAssignmentId))
        && !existsAfter(assignmentPath(playerId, newAssignmentId));
      return membershipFieldsOk
        && (nextWeekPrep
          ? nextWeekPrepAssignmentOk
          : (activeAssignmentChange
            && !hasWeeklyRaidClaimAfter(
              playerId,
              recruitment.currentCycleKey,
              newData.characterId,
              recruitment.raidId
            )));
    }

    function validAssignmentRoleChange(playerId, data, newData) {
      let member = getAfter(recruitmentMemberPath(
        data.recruitmentId,
        playerId
      )).data;
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && newData.diff(data).affectedKeys().hasOnly(['role', 'updatedAt'])
        && newData.role in ['dealer', 'support']
        && newData.role == member.role
        && newData.characterId == member.characterId
        && newData.updatedAt == request.time;
    }

    function validCycleAdvanceAssignmentUpdate(
      playerId,
      assignmentId,
      data,
      newData
    ) {
      let before = get(recruitmentPath(data.recruitmentId)).data;
      let after = getAfter(recruitmentPath(data.recruitmentId)).data;
      let member = getAfter(
        recruitmentMemberPath(data.recruitmentId, playerId)
      ).data;
      return hasActiveBinding()
        && currentPlayerId() in before.memberPlayerIds
        && playerId in before.memberPlayerIds
        && before.status == 'active'
        && before.continueTogether == true
        && request.time >= before.cycleEndsAt
        && after.status == 'active'
        && after.currentCycleStatus == 'active'
        && after.currentCycleKey != before.currentCycleKey
        && assignmentId == data.characterId + '_' + data.raidId
        && data.cycleKey == before.currentCycleKey
        && data.raidId == before.raidId
        && data.characterId == member.characterId
        && data.role == member.role
        && newData.diff(data).affectedKeys().hasOnly([
          'cycleKey', 'updatedAt'
        ])
        && newData.cycleKey == after.currentCycleKey
        && newData.updatedAt == request.time
        && !hasWeeklyRaidClaimAfter(
          playerId,
          newData.cycleKey,
          newData.characterId,
          newData.raidId
        );
    }

    function validLegacyIncompleteAssignmentReplacement(
      playerId,
      assignmentId,
      data,
      newData
    ) {
      let oldRecruitment = get(
        recruitmentPath(data.recruitmentId)
      ).data;
      return data.recruitmentId != newData.recruitmentId
        && data.raidId == oldRecruitment.raidId
        && data.cycleKey == oldRecruitment.currentCycleKey
        && data.cycleKey != newData.cycleKey
        && oldRecruitment.status == 'incompleteEnded'
        && oldRecruitment.currentCycleStatus == 'incompleteEnded'
        && oldRecruitment.continueTogether == false
        && request.time >= oldRecruitment.cycleEndsAt
        && (validInitialAssignment(playerId, assignmentId, newData)
          || validJoinedAssignment(playerId, assignmentId, newData));
    }

    function validApprovalPermissionChange(recruitmentId, playerId, oldData, newData) {
      let recruitment = get(recruitmentPath(recruitmentId)).data;
      return hasActiveBinding()
        && recruitment.leaderPlayerId == currentPlayerId()
        && playerId != currentPlayerId()
        && newData.diff(oldData).affectedKeys().hasOnly([
          'canApproveApplications', 'updatedAt'
        ])
        && newData.canApproveApplications is bool
        && newData.updatedAt == request.time;
    }

    function validMemberPositionChange(recruitmentId, playerId, oldData, newData) {
      let recruitment = getAfter(recruitmentPath(recruitmentId)).data;
      return hasActiveBinding()
        && recruitment.leaderPlayerId == currentPlayerId()
        && playerId != currentPlayerId()
        && recruitment.slotLedgerVersion == 1
        && newData.diff(oldData).affectedKeys().hasOnly([
          'partyIndex', 'slotIndex', 'updatedAt'
        ])
        && (newData.partyIndex != oldData.partyIndex
          || newData.slotIndex != oldData.slotIndex)
        && newData.partyIndex >= 0
        && newData.partyIndex < recruitment.partyCount
        && newData.slotIndex >= 0
        && newData.slotIndex < recruitment.membersPerParty
        && newData.updatedAt == request.time
        && (!existsAfter(recruitmentSlotPath(
            recruitmentId,
            oldData.partyIndex,
            oldData.slotIndex
          ))
          || getAfter(recruitmentSlotPath(
            recruitmentId,
            oldData.partyIndex,
            oldData.slotIndex
          )).data.playerId != playerId)
        && getAfter(recruitmentSlotPath(
          recruitmentId,
          newData.partyIndex,
          newData.slotIndex
        )).data.playerId == playerId
        && validPartyCompositionForMember(recruitmentId, newData);
    }

    function validMemberRemoval(recruitmentId, playerId, data) {
      let recruitment = get(recruitmentPath(recruitmentId)).data;
      let after = getAfter(recruitmentPath(recruitmentId)).data;
      let assignmentId = data.characterId + '_' + recruitment.raidId;
      return hasActiveBinding()
        && (playerId == currentPlayerId()
          || recruitment.leaderPlayerId == currentPlayerId()
          || isLostGroupQualificationCleanup(
            recruitment,
            currentPlayerId(),
            playerId
          ))
        && !(playerId in after.memberPlayerIds)
        && !existsAfter(assignmentPath(playerId, assignmentId));
    }

    function validPartySlotCreate(recruitmentId, slotId, data) {
      let recruitment = getAfter(recruitmentPath(recruitmentId)).data;
      let member = getAfter(
        recruitmentMemberPath(recruitmentId, data.playerId)
      ).data;
      return hasActiveBinding()
        && recruitment.slotLedgerVersion == 1
        && data.keys().hasOnly([
          'playerId', 'partyIndex', 'slotIndex', 'role',
          'classNameSnapshot', 'updatedAt'
        ])
        && (
          (data.partyIndex == 0 && data.slotIndex == 0 && slotId == '0_0')
          || (data.partyIndex == 0 && data.slotIndex == 1 && slotId == '0_1')
          || (data.partyIndex == 0 && data.slotIndex == 2 && slotId == '0_2')
          || (data.partyIndex == 0 && data.slotIndex == 3 && slotId == '0_3')
          || (data.partyIndex == 1 && data.slotIndex == 0 && slotId == '1_0')
          || (data.partyIndex == 1 && data.slotIndex == 1 && slotId == '1_1')
          || (data.partyIndex == 1 && data.slotIndex == 2 && slotId == '1_2')
          || (data.partyIndex == 1 && data.slotIndex == 3 && slotId == '1_3')
        )
        && data.partyIndex >= 0
        && data.partyIndex < recruitment.partyCount
        && data.slotIndex >= 0
        && data.slotIndex < recruitment.membersPerParty
        && data.updatedAt == request.time
        && member.partyIndex == data.partyIndex
        && member.slotIndex == data.slotIndex
        && member.role == data.role
        && member.classNameSnapshot == data.classNameSnapshot;
    }

    function validPartySlotDelete(recruitmentId, data) {
      let memberPath = recruitmentMemberPath(recruitmentId, data.playerId);
      let recruitment = getAfter(recruitmentPath(recruitmentId)).data;
      return hasActiveBinding()
        && (
          (!existsAfter(memberPath))
          || (data.playerId == currentPlayerId()
            && (getAfter(memberPath).data.partyIndex != data.partyIndex
              || getAfter(memberPath).data.slotIndex != data.slotIndex))
          || (recruitment.leaderPlayerId == currentPlayerId()
            && data.playerId != currentPlayerId()
            && (getAfter(memberPath).data.partyIndex != data.partyIndex
              || getAfter(memberPath).data.slotIndex != data.slotIndex))
        );
    }

    function validPartySlotUpdate(recruitmentId, oldData, newData) {
      let recruitment = getAfter(recruitmentPath(recruitmentId)).data;
      let member = getAfter(
        recruitmentMemberPath(recruitmentId, newData.playerId)
      ).data;
      return hasActiveBinding()
        && recruitment.leaderPlayerId == currentPlayerId()
        && recruitment.slotLedgerVersion == 1
        && newData.diff(oldData).affectedKeys().hasOnly([
          'playerId', 'role', 'classNameSnapshot', 'updatedAt'
        ])
        && newData.playerId != oldData.playerId
        && newData.updatedAt == request.time
        && member.partyIndex == newData.partyIndex
        && member.slotIndex == newData.slotIndex
        && member.role == newData.role
        && member.classNameSnapshot == newData.classNameSnapshot;
    }

    function validAssignmentRemoval(playerId, data) {
      return hasActiveBinding()
        && (
          (playerId == currentPlayerId()
            && !exists(recruitmentPath(data.recruitmentId)))
          || validAssignmentRemovalForExistingRecruitment(playerId, data)
        );
    }

    function validAssignmentRemovalForExistingRecruitment(playerId, data) {
      let recruitment = get(recruitmentPath(data.recruitmentId)).data;
      let after = getAfter(recruitmentPath(data.recruitmentId)).data;
      let memberPath = recruitmentMemberPath(data.recruitmentId, playerId);
      let cyclePath = recruitmentCyclePath(
        data.recruitmentId,
        recruitment.currentCycleKey
      );
      // 파티 전체 완료: membership은 유지한 채 assignment만 제거한다.
      // cycle.memberPlayerIds 순서/타입에 의존하지 않고 완료 전 membership을 기준으로 본다.
      let partyCompleteRemoval = hasActiveBinding()
        && recruitment.leaderPlayerId == currentPlayerId()
        && after.currentCycleStatus == 'completed'
        && existsAfter(cyclePath)
        && getAfter(cyclePath).data.status == 'completed'
        && playerId in recruitment.memberPlayerIds
        && exists(memberPath)
        && get(memberPath).data.characterId == data.characterId
        && data.raidId == recruitment.raidId;
      // E 이전 completed·해산 대기 orphan: 본인 점유만 정리. Claim은 만들지 않는다.
      let staleCompletedRemoval = hasActiveBinding()
        && playerId == currentPlayerId()
        && data.raidId == recruitment.raidId
        && (recruitment.status == 'completed'
          || recruitment.status == 'disbanded'
          || recruitment.currentCycleStatus == 'completed');
      let oneShotCycleAdvanceRemoval = hasActiveBinding()
        && currentPlayerId() in recruitment.memberPlayerIds
        && playerId in recruitment.memberPlayerIds
        && recruitment.status == 'active'
        && recruitment.continueTogether == false
        && request.time >= recruitment.cycleEndsAt
        && data.cycleKey == recruitment.currentCycleKey
        && data.raidId == recruitment.raidId
        && after.status == 'incompleteEnded'
        && after.currentCycleStatus == 'incompleteEnded';
      return (playerId == currentPlayerId()
          || recruitment.leaderPlayerId == currentPlayerId()
          || after.status == 'disbanded'
          || oneShotCycleAdvanceRemoval
          || isLostGroupQualificationCleanup(
            recruitment,
            currentPlayerId(),
            playerId
          ))
        && (partyCompleteRemoval
          || staleCompletedRemoval
          || oneShotCycleAdvanceRemoval
          || !existsAfter(memberPath)
          || (existsAfter(memberPath)
            && getAfter(memberPath).data.characterId != data.characterId)
          || after.status == 'disbanded');
    }

    function validCompletionCancelAssignmentRestore(
      playerId,
      assignmentId,
      data
    ) {
      let recruitment = getAfter(recruitmentPath(data.recruitmentId)).data;
      let cycle = getAfter(recruitmentCyclePath(
        data.recruitmentId,
        data.cycleKey
      )).data;
      let member = get(recruitmentMemberPath(data.recruitmentId, playerId)).data;
      return hasActiveBinding()
        && recruitment.leaderPlayerId == currentPlayerId()
        && recruitment.status == 'active'
        && recruitment.currentCycleStatus == 'active'
        && recruitment.currentCycleKey == data.cycleKey
        && cycle.status == 'completionCancelled'
        && playerId in cycle.memberPlayerIds
        && data.schemaVersion == 1
        && data.playerId == playerId
        && assignmentId == data.characterId + '_' + data.raidId
        && data.raidId == recruitment.raidId
        && data.characterId == member.characterId
        && data.role == member.role
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && !hasWeeklyRaidClaimAfter(
          playerId,
          data.cycleKey,
          data.characterId,
          data.raidId
        );
    }

    function validEventTiming(data) {
      return data.occurredAt == request.time
        && data.expiresAt >= request.time + duration.value(27, 'd')
        && data.expiresAt <= request.time + duration.value(29, 'd');
    }

    function validCycleEvent(playerId, eventId, data) {
      let cycle = getAfter(recruitmentCyclePath(
        data.recruitmentId,
        data.cycleKey
      )).data;
      let expectedStatus = data.type == 'partyCompleted'
        ? 'completed'
        : (data.type == 'partyCompletionCancelled'
          ? 'completionCancelled'
          : 'incompleteEnded');
      return hasActiveBinding()
        && data.keys().hasOnly([
          'schemaVersion', 'eventId', 'type', 'playerId', 'recruitmentId',
          'cycleKey', 'raidId', 'difficultyId', 'eventRevision', 'characterId',
          'characterNameSnapshot', 'classNameSnapshot', 'role', 'partyIndex',
          'occurredAt', 'expiresAt'
        ])
        && data.schemaVersion == 1
        && data.eventId == eventId
        && data.playerId == playerId
        && data.type in [
          'partyCompleted',
          'partyCompletionCancelled',
          'partyIncompleteEnded'
        ]
        && cycle.status == expectedStatus
        && cycle.updatedAt == request.time
        && playerId in cycle.memberPlayerIds
        && data.eventRevision == cycle.completionRevision
        && data.raidId is string
        && data.difficultyId is string
        && data.characterId is string
        && validEventTiming(data);
    }

    // 신청 계열: 같은 Transaction의 application 상태 전이와 수신자만 허용.
    // 명령 Repository가 이벤트를 쓰지 않으면 orphan create는 전이 검증에서 거절된다.
    function validApplicationEvent(playerId, eventId, data) {
      return data.type == 'applicationSubmitted'
        ? validApplicationSubmittedEvent(playerId, eventId, data)
        : (data.type == 'applicationApproved'
          ? validApplicationApprovedEvent(playerId, eventId, data)
          : (data.type == 'applicationRejected'
            ? validApplicationRejectedEvent(playerId, eventId, data)
            : (data.type == 'applicationWithdrawn'
              ? validApplicationWithdrawnEvent(playerId, eventId, data)
              : false)));
    }

    function validApplicationEventBase(playerId, eventId, data) {
      return hasActiveBinding()
        && data.keys().hasOnly([
          'schemaVersion', 'eventId', 'type', 'playerId', 'recruitmentId',
          'eventRevision', 'actorPlayerId', 'characterNameSnapshot',
          'classNameSnapshot', 'role', 'raidId', 'difficultyId',
          'rejectionCount', 'occurredAt', 'expiresAt'
        ])
        && data.schemaVersion == 1
        && data.eventId == eventId
        && data.playerId == playerId
        && data.recruitmentId is string
        && data.eventRevision is int
        && data.actorPlayerId is string
        && data.characterNameSnapshot is string
        && validEventTiming(data);
    }

    function validApplicationSubmittedEvent(playerId, eventId, data) {
      let recruitment = get(recruitmentPath(data.recruitmentId)).data;
      let application = getAfter(recruitmentApplicationPath(
        data.recruitmentId,
        data.actorPlayerId
      )).data;
      return validApplicationEventBase(playerId, eventId, data)
        && data.type == 'applicationSubmitted'
        && currentPlayerId() == data.actorPlayerId
        && playerId == recruitment.leaderPlayerId
        && playerId != data.actorPlayerId
        && application.status == 'pending'
        && application.applicantPlayerId == data.actorPlayerId
        && application.revision == data.eventRevision
        && application.updatedAt == request.time
        && application.characterNameSnapshot == data.characterNameSnapshot;
    }

    function validApplicationApprovedEvent(playerId, eventId, data) {
      let application = getAfter(recruitmentApplicationPath(
        data.recruitmentId,
        playerId
      )).data;
      return validApplicationEventBase(playerId, eventId, data)
        && data.type == 'applicationApproved'
        && canApproveApplications(data.recruitmentId)
        && currentPlayerId() == data.actorPlayerId
        && playerId == application.applicantPlayerId
        && playerId != data.actorPlayerId
        && application.status == 'approved'
        && application.revision == data.eventRevision
        && application.updatedAt == request.time
        && application.characterNameSnapshot == data.characterNameSnapshot;
    }

    function validApplicationRejectedEvent(playerId, eventId, data) {
      let application = getAfter(recruitmentApplicationPath(
        data.recruitmentId,
        playerId
      )).data;
      return validApplicationEventBase(playerId, eventId, data)
        && data.type == 'applicationRejected'
        && canApproveApplications(data.recruitmentId)
        && currentPlayerId() == data.actorPlayerId
        && playerId == application.applicantPlayerId
        && playerId != data.actorPlayerId
        && application.status == 'rejected'
        && application.revision == data.eventRevision
        && application.updatedAt == request.time
        && application.characterNameSnapshot == data.characterNameSnapshot
        && (!('rejectionCount' in data)
          || data.rejectionCount == application.rejectionCount);
    }

    function validApplicationWithdrawnEvent(playerId, eventId, data) {
      let recruitment = get(recruitmentPath(data.recruitmentId)).data;
      let application = getAfter(recruitmentApplicationPath(
        data.recruitmentId,
        data.actorPlayerId
      )).data;
      return validApplicationEventBase(playerId, eventId, data)
        && data.type == 'applicationWithdrawn'
        && currentPlayerId() == data.actorPlayerId
        && playerId == recruitment.leaderPlayerId
        && playerId != data.actorPlayerId
        && application.status == 'withdrawn'
        && application.applicantPlayerId == data.actorPlayerId
        && application.revision == data.eventRevision
        && application.updatedAt == request.time
        && application.characterNameSnapshot == data.characterNameSnapshot;
    }

    // 멤버십 계열: 모집 revision·멤버 전후 집합과 수신자를 검증한다.
    function validMembershipEvent(playerId, eventId, data) {
      return data.type == 'memberJoined'
        ? validMemberJoinedEvent(playerId, eventId, data)
        : (data.type == 'memberLeft'
          ? validMemberLeftEvent(playerId, eventId, data)
          : (data.type == 'memberKicked'
            ? validMemberKickedEvent(playerId, eventId, data)
            : (data.type == 'memberCharacterChanged'
              ? validMemberCharacterChangedEvent(playerId, eventId, data)
              : (data.type == 'memberMoved'
                ? validMemberMovedEvent(playerId, eventId, data)
                : false))));
    }

    function validMembershipEventBase(playerId, eventId, data) {
      return hasActiveBinding()
        && data.keys().hasOnly([
          'schemaVersion', 'eventId', 'type', 'playerId', 'recruitmentId',
          'eventRevision', 'actorPlayerId', 'targetPlayerId',
          'characterNameSnapshot', 'classNameSnapshot', 'role',
          'previousCharacterNameSnapshot', 'targetCharacterNameSnapshot',
          'raidId', 'difficultyId', 'partyIndex', 'slotIndex',
          'previousPartyIndex', 'previousSlotIndex', 'reason', 'occurredAt',
          'expiresAt'
        ])
        && data.schemaVersion == 1
        && data.eventId == eventId
        && data.playerId == playerId
        && data.recruitmentId is string
        && data.eventRevision is int
        && data.actorPlayerId is string
        && validEventTiming(data);
    }

    function validMemberJoinedEvent(playerId, eventId, data) {
      let before = get(recruitmentPath(data.recruitmentId)).data;
      let after = getAfter(recruitmentPath(data.recruitmentId)).data;
      return validMembershipEventBase(playerId, eventId, data)
        && data.type == 'memberJoined'
        && currentPlayerId() == data.actorPlayerId
        && data.eventRevision == after.revision
        && data.eventRevision == before.revision + 1
        && !(data.actorPlayerId in before.memberPlayerIds)
        && data.actorPlayerId in after.memberPlayerIds
        && playerId in before.memberPlayerIds
        && playerId != data.actorPlayerId
        && data.characterNameSnapshot is string
        && existsAfter(recruitmentMemberPath(
          data.recruitmentId,
          data.actorPlayerId
        ));
    }

    function validMemberLeftEvent(playerId, eventId, data) {
      let before = get(recruitmentPath(data.recruitmentId)).data;
      let after = getAfter(recruitmentPath(data.recruitmentId)).data;
      return validMembershipEventBase(playerId, eventId, data)
        && data.type == 'memberLeft'
        && currentPlayerId() == data.actorPlayerId
        && data.eventRevision == after.revision
        && data.eventRevision == before.revision + 1
        && data.actorPlayerId in before.memberPlayerIds
        && !(data.actorPlayerId in after.memberPlayerIds)
        && playerId in before.memberPlayerIds
        && playerId != data.actorPlayerId
        && data.characterNameSnapshot is string
        && (!('reason' in data) || data.reason == 'weeklyRaidCompleted');
    }

    function validMemberKickedEvent(playerId, eventId, data) {
      let before = get(recruitmentPath(data.recruitmentId)).data;
      let after = getAfter(recruitmentPath(data.recruitmentId)).data;
      return validMembershipEventBase(playerId, eventId, data)
        && data.type == 'memberKicked'
        && currentPlayerId() == data.actorPlayerId
        && (before.leaderPlayerId == data.actorPlayerId
          || isLostGroupQualificationCleanup(
            before,
            data.actorPlayerId,
            data.targetPlayerId
          ))
        && data.targetPlayerId is string
        && data.eventRevision == after.revision
        && data.eventRevision == before.revision + 1
        && data.targetPlayerId in before.memberPlayerIds
        && !(data.targetPlayerId in after.memberPlayerIds)
        && playerId != data.actorPlayerId
        && (playerId == data.targetPlayerId
          || playerId in after.memberPlayerIds)
        && data.targetCharacterNameSnapshot is string;
    }

    function validMemberCharacterChangedEvent(playerId, eventId, data) {
      let before = get(recruitmentPath(data.recruitmentId)).data;
      let after = getAfter(recruitmentPath(data.recruitmentId)).data;
      let memberAfter = getAfter(recruitmentMemberPath(
        data.recruitmentId,
        data.actorPlayerId
      )).data;
      return validMembershipEventBase(playerId, eventId, data)
        && data.type == 'memberCharacterChanged'
        && currentPlayerId() == data.actorPlayerId
        && data.eventRevision == after.revision
        && data.eventRevision == before.revision + 1
        && data.actorPlayerId in before.memberPlayerIds
        && data.actorPlayerId in after.memberPlayerIds
        && playerId in before.memberPlayerIds
        && playerId != data.actorPlayerId
        && memberAfter.updatedAt == request.time
        && data.characterNameSnapshot is string
        && data.previousCharacterNameSnapshot is string;
    }

    function validMemberMovedEvent(playerId, eventId, data) {
      let before = get(recruitmentPath(data.recruitmentId)).data;
      let after = getAfter(recruitmentPath(data.recruitmentId)).data;
      let memberAfter = getAfter(recruitmentMemberPath(
        data.recruitmentId,
        data.targetPlayerId
      )).data;
      let memberBefore = get(recruitmentMemberPath(
        data.recruitmentId,
        data.targetPlayerId
      )).data;
      return validMembershipEventBase(playerId, eventId, data)
        && data.type == 'memberMoved'
        && currentPlayerId() == data.actorPlayerId
        && before.leaderPlayerId == data.actorPlayerId
        && data.targetPlayerId != data.actorPlayerId
        && data.eventRevision == after.revision
        && data.eventRevision == before.revision + 1
        && data.targetPlayerId in before.memberPlayerIds
        && data.targetPlayerId in after.memberPlayerIds
        && playerId in before.memberPlayerIds
        && playerId != data.actorPlayerId
        && memberAfter.updatedAt == request.time
        && memberAfter.partyIndex == data.partyIndex
        && memberAfter.slotIndex == data.slotIndex
        && memberBefore.partyIndex == data.previousPartyIndex
        && memberBefore.slotIndex == data.previousSlotIndex;
    }

    function validLifecycleEvent(playerId, eventId, data) {
      return data.type == 'partyDisbanded'
        ? validPartyDisbandedEvent(playerId, eventId, data)
        : false;
    }

    function validPartyDisbandedEvent(playerId, eventId, data) {
      let before = get(recruitmentPath(data.recruitmentId)).data;
      let after = getAfter(recruitmentPath(data.recruitmentId)).data;
      let applicationPath = recruitmentApplicationPath(
        data.recruitmentId,
        playerId
      );
      let isFormerMember = playerId in before.memberPlayerIds;
      let isPendingApplicant = exists(applicationPath)
        && get(applicationPath).data.status == 'pending'
        && get(applicationPath).data.applicantPlayerId == playerId;
      return hasActiveBinding()
        && data.keys().hasOnly([
          'schemaVersion', 'eventId', 'type', 'playerId', 'recruitmentId',
          'cycleKey', 'eventRevision', 'actorPlayerId', 'raidId',
          'difficultyId', 'characterNameSnapshot', 'endReason',
          'occurredAt', 'expiresAt'
        ])
        && data.schemaVersion == 1
        && data.eventId == eventId
        && data.playerId == playerId
        && data.type == 'partyDisbanded'
        && data.recruitmentId is string
        && data.cycleKey == before.currentCycleKey
        && data.eventRevision is int
        && data.actorPlayerId is string
        && currentPlayerId() == data.actorPlayerId
        && data.actorPlayerId == before.leaderPlayerId
        && playerId != data.actorPlayerId
        && after.status == 'disbanded'
        && after.revision == before.revision + 1
        && data.eventRevision == after.revision
        && (isFormerMember || isPendingApplicant)
        && validEventTiming(data);
    }

    function validPlayerEvent(playerId, eventId, data) {
      return validCycleEvent(playerId, eventId, data)
        || validApplicationEvent(playerId, eventId, data)
        || validMembershipEvent(playerId, eventId, data)
        || validLifecycleEvent(playerId, eventId, data)
        || validManualVerificationDisputeEvent(playerId, eventId, data);
    }

    function validManualVerificationDisputeEvent(playerId, eventId, data) {
      let requestPath = /databases/$(database)/documents/manualVerificationRequests/$(data.requestId);
      let requestData = get(requestPath).data;
      return isActiveOperator()
        && data.keys().hasOnly([
          'schemaVersion', 'eventId', 'type', 'playerId', 'requestId',
          'requesterPlayerId', 'targetGameAccountId',
          'proofCharacterNameSnapshot', 'ownerResponseDeadlineAt',
          'occurredAt', 'expiresAt'
        ])
        && data.schemaVersion == 1
        && data.eventId == eventId
        && data.playerId == playerId
        && data.type == 'manualVerificationDisputeOpened'
        && data.requestId is string
        && data.requestId.size() > 0
        && eventId == 'mvd_' + data.requestId
        && data.requesterPlayerId is string
        && data.targetGameAccountId is string
        && data.proofCharacterNameSnapshot is string
        && data.ownerResponseDeadlineAt is timestamp
        && requestData.status == 'awaitingOwnerResponse'
        && requestData.previousOwnerPlayerId == playerId
        && requestData.targetGameAccountId == data.targetGameAccountId
        && requestData.ownerResponseDeadlineAt == data.ownerResponseDeadlineAt
        && validEventTiming(data);
    }

    function validPendingApplication(recruitmentId, playerId, data) {
      let recruitment = get(recruitmentPath(recruitmentId)).data;
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && data.schemaVersion == 1
        && data.recruitmentId == recruitmentId
        && data.applicantPlayerId == playerId
        && data.cycleKey == recruitment.targetCycleKey
        && data.status == 'pending'
        && data.revision == 1
        && data.approvalCount == 0
        && data.rejectionCount == 0
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && recruitment.status == 'active'
        && recruitment.manualRecruitmentEnabled == true
        && recruitment.hasAvailableSlot == true
        && recruitment.approvalPolicy.mode == 'leaderOnly'
        && canAccessRecruitmentByAudience(recruitment)
        && !(playerId in recruitment.memberPlayerIds)
        && ownsActiveCharacter(data.characterId)
        && !hasWeeklyRaidClaimAfter(
          playerId,
          data.cycleKey,
          data.characterId,
          recruitment.raidId
        );
    }

    function validApplicantWithdrawal(playerId, oldData, newData) {
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && oldData.applicantPlayerId == playerId
        && oldData.status == 'pending'
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'resolutionReason', 'revision', 'decidedAt', 'updatedAt'
        ])
        && newData.status == 'withdrawn'
        && newData.resolutionReason == 'withdrawnByApplicant'
        && newData.revision == oldData.revision + 1
        && newData.decidedAt == request.time
        && newData.updatedAt == request.time;
    }

    function validApplicationWeeklyCompletion(playerId, oldData, newData) {
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && oldData.applicantPlayerId == playerId
        && oldData.status == 'pending'
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'resolutionReason', 'revision', 'decidedAt', 'updatedAt'
        ])
        && newData.status == 'superseded'
        && newData.resolutionReason == 'weeklyRaidCompleted'
        && newData.revision == oldData.revision + 1
        && newData.decidedAt == request.time
        && newData.updatedAt == request.time
        && hasWeeklyRaidClaimAfter(
          playerId,
          oldData.cycleKey,
          oldData.characterId,
          get(recruitmentPath(oldData.recruitmentId)).data.raidId
        );
    }

    // 거절·철회·superseded 후 같은 방 재신청. rejectionCount는 유지한다.
    function validApplicationReapply(recruitmentId, playerId, oldData, newData) {
      let recruitment = get(recruitmentPath(recruitmentId)).data;
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && oldData.applicantPlayerId == playerId
        && (oldData.status == 'rejected'
          || oldData.status == 'withdrawn'
          || oldData.status == 'superseded'
          || oldData.status == 'approved')
        && newData.diff(oldData).affectedKeys().hasOnly([
          'cycleKey', 'characterId', 'characterNameSnapshot', 'classNameSnapshot',
          'requestedRole', 'submittedBuildSnapshot', 'status', 'resolutionReason',
          'approvalCount', 'revision', 'decidedAt', 'updatedAt'
        ])
        && newData.status == 'pending'
        && newData.resolutionReason == null
        && newData.approvalCount == 0
        && newData.rejectionCount == oldData.rejectionCount
        && newData.revision == oldData.revision + 1
        && newData.decidedAt == null
        && newData.updatedAt == request.time
        && newData.schemaVersion == oldData.schemaVersion
        && newData.recruitmentId == recruitmentId
        && newData.applicantPlayerId == playerId
        && newData.cycleKey == recruitment.targetCycleKey
        && newData.characterId is string
        && newData.characterId.size() > 0
        && newData.characterNameSnapshot is string
        && newData.classNameSnapshot is string
        && (newData.requestedRole == 'dealer'
          || newData.requestedRole == 'support')
        && recruitment.status == 'active'
        && recruitment.manualRecruitmentEnabled == true
        && recruitment.hasAvailableSlot == true
        && recruitment.approvalPolicy.mode == 'leaderOnly'
        && canAccessRecruitmentByAudience(recruitment)
        && !(playerId in recruitment.memberPlayerIds)
        && ownsActiveCharacter(newData.characterId)
        && !hasWeeklyRaidClaimAfter(
          playerId,
          newData.cycleKey,
          newData.characterId,
          recruitment.raidId
        );
    }

    function validPartyOwnerWeeklyRaidClaimCreate(playerId, claimId, data) {
      let recruitmentAfter = getAfter(recruitmentPath(data.sourceRecruitmentId)).data;
      let cycle = getAfter(recruitmentCyclePath(
        data.sourceRecruitmentId,
        data.cycleKey
      )).data;
      let memberPath = recruitmentMemberPath(data.sourceRecruitmentId, playerId);
      let assignmentId = data.characterId + '_' + data.raidId;
      return hasActiveBinding()
        && recruitmentAfter.leaderPlayerId == currentPlayerId()
        && recruitmentAfter.currentCycleStatus == 'completed'
        && data.keys().hasOnly([
          'schemaVersion', 'playerId', 'characterId', 'raidId', 'cycleKey',
          'difficultyId', 'source', 'sourceRecruitmentId',
          'sourceCompletionRevision', 'cycleStartedAt', 'cycleEndsAt',
          'completedAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.playerId == playerId
        && data.characterId is string
        && data.raidId is string
        && data.difficultyId is string
        && data.cycleKey is string
        && data.sourceRecruitmentId is string
        && (data.sourceCompletionRevision is int
          || data.sourceCompletionRevision is float)
        && data.cycleStartedAt is timestamp
        && data.cycleEndsAt is timestamp
        && data.completedAt is timestamp
        && data.updatedAt is timestamp
        && claimId == weeklyRaidClaimId(
          data.cycleKey,
          data.characterId,
          data.raidId
        )
        && data.source == 'partyOwner'
        && data.cycleKey == recruitmentAfter.currentCycleKey
        && data.raidId == recruitmentAfter.raidId
        && data.difficultyId == recruitmentAfter.difficultyId
        && data.cycleStartedAt == recruitmentAfter.cycleStartedAt
        && data.cycleEndsAt == recruitmentAfter.cycleEndsAt
        && data.completedAt == request.time
        && data.updatedAt == request.time
        && cycle.status == 'completed'
        && int(cycle.completionRevision) == int(data.sourceCompletionRevision)
        && cycle.completedByPlayerId == currentPlayerId()
        && playerId in recruitmentAfter.memberPlayerIds
        && exists(memberPath)
        && data.characterId == getAfter(memberPath).data.characterId
        && !existsAfter(assignmentPath(playerId, assignmentId));
    }

    function validPartyOwnerWeeklyRaidClaimDelete(playerId, claimId, data) {
      let recruitmentAfter = getAfter(recruitmentPath(data.sourceRecruitmentId)).data;
      let cycle = getAfter(recruitmentCyclePath(
        data.sourceRecruitmentId,
        data.cycleKey
      )).data;
      let cancelDelete = cycle.status == 'completionCancelled'
        && recruitmentAfter.currentCycleStatus == 'active'
        && int(cycle.completionRevision) == int(data.sourceCompletionRevision) + 1;
      // 취소 후 재완료 때 이전 partyOwner Claim을 새 completionRevision으로 교체
      let recompleteReplace = cycle.status == 'completed'
        && recruitmentAfter.currentCycleStatus == 'completed'
        && cycle.completedByPlayerId == currentPlayerId()
        && int(cycle.completionRevision) > int(data.sourceCompletionRevision);
      return hasActiveBinding()
        && recruitmentAfter.leaderPlayerId == currentPlayerId()
        && data.playerId == playerId
        && data.characterId is string
        && data.raidId is string
        && data.cycleKey is string
        && data.sourceRecruitmentId is string
        && (data.sourceCompletionRevision is int
          || data.sourceCompletionRevision is float)
        && claimId == weeklyRaidClaimId(
          data.cycleKey,
          data.characterId,
          data.raidId
        )
        && data.source == 'partyOwner'
        && data.cycleKey == recruitmentAfter.currentCycleKey
        && data.raidId == recruitmentAfter.raidId
        && (cancelDelete || recompleteReplace);
    }

    function validPartyOwnerWeeklyRaidClaimUpdate(playerId, claimId, data, newData) {
      return validPartyOwnerWeeklyRaidClaimCreate(playerId, claimId, newData)
        && data.source == 'partyOwner'
        && data.sourceRecruitmentId == newData.sourceRecruitmentId
        && data.playerId == newData.playerId
        && data.characterId == newData.characterId
        && data.raidId == newData.raidId
        && data.cycleKey == newData.cycleKey
        && int(newData.sourceCompletionRevision) > int(data.sourceCompletionRevision);
    }

    function validManualWeeklyRaidClaimCreate(playerId, claimId, data) {
      let assignmentId = data.characterId + '_' + data.raidId;
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && data.keys().hasOnly([
          'schemaVersion', 'playerId', 'characterId', 'raidId', 'cycleKey',
          'difficultyId', 'source', 'cycleStartedAt', 'cycleEndsAt',
          'completedAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.playerId == playerId
        && data.characterId is string
        && data.raidId is string
        && data.difficultyId is string
        && data.cycleKey is string
        && data.cycleStartedAt is timestamp
        && data.cycleEndsAt is timestamp
        && data.completedAt is timestamp
        && data.updatedAt is timestamp
        && data.characterId.matches('^[A-Za-z0-9]{20}$')
        && data.raidId.matches('^[a-z0-9_]+$')
        && data.difficultyId.matches('^[a-z0-9_]+$')
        && data.cycleKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && claimId == weeklyRaidClaimId(
          data.cycleKey,
          data.characterId,
          data.raidId
        )
        && data.source == 'manual'
        && data.cycleEndsAt == data.cycleStartedAt + duration.value(7, 'd')
        && request.time >= data.cycleStartedAt
        && request.time < data.cycleEndsAt
        && data.completedAt == request.time
        && data.updatedAt == request.time
        && ownsActiveCharacter(data.characterId)
        && !existsAfter(assignmentPath(playerId, assignmentId));
    }

    function validManualWeeklyRaidClaimDelete(playerId, claimId, data) {
      return hasActiveBinding()
        && playerId == currentPlayerId()
        && data.playerId == playerId
        && data.characterId is string
        && data.raidId is string
        && data.cycleKey is string
        && data.cycleStartedAt is timestamp
        && data.cycleEndsAt is timestamp
        && claimId == weeklyRaidClaimId(
          data.cycleKey,
          data.characterId,
          data.raidId
        )
        && data.cycleEndsAt == data.cycleStartedAt + duration.value(7, 'd')
        && request.time >= data.cycleStartedAt
        && request.time < data.cycleEndsAt;
    }

    function validApplicationDecision(recruitmentId, oldData, newData) {
      let approved = newData.status == 'approved'
        && newData.approvalCount == oldData.approvalCount + 1
        && newData.rejectionCount == oldData.rejectionCount
        && existsAfter(recruitmentMemberPath(
          recruitmentId,
          oldData.applicantPlayerId
        ));
      let rejected = newData.status == 'rejected'
        && newData.rejectionCount == oldData.rejectionCount + 1
        && newData.approvalCount == oldData.approvalCount;
      return hasActiveBinding()
        && canApproveApplications(recruitmentId)
        && oldData.status == 'pending'
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'resolutionReason', 'approvalCount', 'rejectionCount',
          'revision', 'decidedAt', 'updatedAt'
        ])
        && ((approved && newData.resolutionReason == 'approvedByApprover')
          || (rejected && newData.resolutionReason == 'rejectedByApprover'))
        && newData.revision == oldData.revision + 1
        && newData.decidedAt == request.time
        && newData.updatedAt == request.time;
    }

    // list 규칙은 쿼리 제약만으로 증명되어야 한다. exists/get이 섞이면
    // 공개 목록·내 현황 쿼리 전체가 permission-denied가 된다.
    function canListRecruitment(data) {
      return hasActiveBinding()
        && (data.visibility == 'public'
          || data.leaderPlayerId == currentPlayerId()
          || currentPlayerId() in data.memberPlayerIds);
    }

    function canReadRecruitment(data) {
      return hasActiveBinding()
        && (canAccessRecruitmentByAudience(data)
          || data.leaderPlayerId == currentPlayerId()
          || currentPlayerId() in data.memberPlayerIds);
    }

    // 생성 Transaction은 신규 ID의 존재 여부를 get으로 확인한다.
    // 없는 문서에서 resource.data를 읽으면 규칙이 거부되므로 단건 get만 분기한다.
    function canGetRecruitment(recruitmentId) {
      return hasActiveBinding()
        && (!exists(recruitmentPath(recruitmentId))
          || canReadRecruitment(resource.data));
    }

    function canReadPrivateRecruitmentData(recruitmentId) {
      let recruitment = get(recruitmentPath(recruitmentId)).data;
      return hasActiveBinding()
        && (recruitment.leaderPlayerId == currentPlayerId()
          || currentPlayerId() in recruitment.memberPlayerIds);
    }

    // Option 1: 공개 모집 membership 목록은 로그인 사용자에게 허용하고
    // Domain/UI는 표시 Snapshot만 소비한다.
    function canReadPublicRecruitmentMembers(recruitmentId) {
      return hasActiveBinding()
        && exists(recruitmentPath(recruitmentId))
        && canAccessRecruitmentByAudience(
          get(recruitmentPath(recruitmentId)).data
        );
    }

    // 신청 Transaction은 신규 application get으로 존재 여부를 확인한다.
    // 없는 문서에서 resource.data를 읽으면 규칙이 거부되므로 단건 get만 분기한다.
    function canGetRecruitmentApplication(recruitmentId, applicantPlayerId) {
      return hasActiveBinding()
        && (!exists(recruitmentApplicationPath(recruitmentId, applicantPlayerId))
          || canReadPrivateRecruitmentData(recruitmentId)
          || resource.data.applicantPlayerId == currentPlayerId());
    }

    function validActiveBinding(data) {
      return data.keys().hasOnly([
          'schemaVersion',
          'playerId',
          'status',
          'linkedAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.playerId is string
        && data.playerId.size() > 0
        && data.status == 'active'
        && data.linkedAt == request.time
        && data.updatedAt == request.time;
    }

    function validActivePlayer(data) {
      return data.keys().hasOnly([
          'schemaVersion',
          'status',
          'lastSeenAt',
          'createdAt',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.status == 'active'
        && data.lastSeenAt == null
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validPlayerLastSeenUpdate(playerId, oldData, newData) {
      return hasActiveBinding()
        && currentPlayerId() == playerId
        && oldData.status == 'active'
        && newData.diff(oldData).affectedKeys().hasOnly(['lastSeenAt'])
        && newData.lastSeenAt == request.time;
    }

    function validLegacyLastSeenBackfill(oldData, newData) {
      return isActiveOperator()
        && !oldData.keys().hasAny(['lastSeenAt'])
        && newData.diff(oldData).affectedKeys().hasOnly(['lastSeenAt'])
        && newData.lastSeenAt == null;
    }

    function changesRepresentativeCharacter(oldData, newData) {
      return newData.diff(oldData).affectedKeys().hasAny([
        'representativeCharacterId',
        'representativeCharacterUpdatedAt'
      ]);
    }

    function representativeCharacterOwned(oldData, newData) {
      let character = get(characterPath(newData.representativeCharacterId)).data;
      return newData.representativeCharacterId is string
        && newData.representativeCharacterId.size() > 0
        && character.ownerPlayerId == oldData.playerId
        && character.gameAccountId == oldData.gameAccountId
        && character.status == 'active';
    }

    function oldRepresentativeCharacterId(oldData) {
      return oldData.keys().hasAny(['representativeCharacterId'])
        ? oldData.representativeCharacterId
        : null;
    }

    function validRepresentativeCharacterSeed(oldData, newData) {
      let oldRepresentative = oldRepresentativeCharacterId(oldData);
      return hasActiveBinding()
        && oldData.playerId == currentPlayerId()
        && oldData.status == 'active'
        && oldData.gameAccountId is string
        && oldRepresentative == null
        && newData.diff(oldData).affectedKeys().hasOnly([
          'representativeCharacterId'
        ])
        && representativeCharacterOwned(oldData, newData)
        && (!newData.keys().hasAny(['representativeCharacterUpdatedAt'])
          || newData.representativeCharacterUpdatedAt == null);
    }

    function validRepresentativeCharacterUpdate(oldData, newData) {
      let oldRepresentative = oldRepresentativeCharacterId(oldData);
      let cooldownPassed = !oldData.keys().hasAny([
          'representativeCharacterUpdatedAt'
        ])
        || oldData.representativeCharacterUpdatedAt == null
        || request.time >= oldData.representativeCharacterUpdatedAt
          + duration.value(5, 'm');
      return hasActiveBinding()
        && oldData.playerId == currentPlayerId()
        && oldData.status == 'active'
        && oldData.gameAccountId is string
        && oldRepresentative != null
        && newData.diff(oldData).affectedKeys().hasOnly([
          'representativeCharacterId',
          'representativeCharacterUpdatedAt'
        ])
        && newData.representativeCharacterId != oldRepresentative
        && newData.representativeCharacterUpdatedAt == request.time
        && cooldownPassed
        && representativeCharacterOwned(oldData, newData);
    }

    function playerGameAccountPath(playerId, gameAccountId) {
      return /databases/$(database)/documents/playerGameAccounts/$(playerId + '_' + gameAccountId);
    }

    function characterActivityPath(playerId, characterId) {
      return /databases/$(database)/documents/players/$(playerId)/characterActivity/$(characterId);
    }

    function ownedActiveCharacterMatches(playerId, characterId, gameAccountId) {
      let characterDoc = characterPath(characterId);
      return exists(characterDoc)
        && get(characterDoc).data.status == 'active'
        && get(characterDoc).data.ownerPlayerId == playerId
        && get(characterDoc).data.gameAccountId == gameAccountId;
    }

    function ownedActiveGameAccount(playerId, gameAccountId) {
      let ownershipDoc = playerGameAccountPath(playerId, gameAccountId);
      return exists(ownershipDoc)
        && get(ownershipDoc).data.playerId == playerId
        && get(ownershipDoc).data.gameAccountId == gameAccountId
        && get(ownershipDoc).data.status == 'active';
    }

    function representativeActivityCovered(playerId, gameAccountId, characterId) {
      let ownershipDoc = playerGameAccountPath(playerId, gameAccountId);
      return !exists(ownershipDoc)
        || !('representativeCharacterId' in get(ownershipDoc).data)
        || !(get(ownershipDoc).data.representativeCharacterId is string)
        || get(ownershipDoc).data.representativeCharacterId.size() == 0
        || characterId == get(ownershipDoc).data.representativeCharacterId
        || existsAfter(characterActivityPath(
          playerId,
          get(ownershipDoc).data.representativeCharacterId
        ));
    }

    function validCharacterActivityWrite(playerId, characterId, data) {
      return hasActiveBinding()
        && currentPlayerId() == playerId
        && characterId == data.characterId
        && data.keys().hasOnly([
          'schemaVersion',
          'playerId',
          'characterId',
          'gameAccountId',
          'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.playerId == playerId
        && data.characterId is string
        && data.characterId.size() > 0
        && data.gameAccountId is string
        && data.gameAccountId.size() > 0
        && data.updatedAt == request.time
        && ownedActiveCharacterMatches(playerId, characterId, data.gameAccountId)
        && ownedActiveGameAccount(playerId, data.gameAccountId)
        && representativeActivityCovered(playerId, data.gameAccountId, characterId);
    }

    function validCharacterActivityDelete(playerId, characterId, oldData) {
      let ownership = get(playerGameAccountPath(playerId, oldData.gameAccountId)).data;
      return hasActiveBinding()
        && currentPlayerId() == playerId
        && oldData.playerId == playerId
        && oldData.characterId == characterId
        && ownership.playerId == playerId
        && ownership.gameAccountId == oldData.gameAccountId
        && (
          !ownership.keys().hasAny(['representativeCharacterId'])
          || ownership.representativeCharacterId == null
          || ownership.representativeCharacterId != characterId
        );
    }

    match /authBindings/{authUid} {
      allow get: if signedIn() && request.auth.uid == authUid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == authUid
        && !exists(bindingPath(authUid))
        && validActiveBinding(request.resource.data)
        && !exists(playerPath(request.resource.data.playerId))
        && getAfter(playerPath(request.resource.data.playerId)).data.status
          == 'active';
      allow update, delete: if false;
    }

    match /operatorAssignments/{playerId} {
      allow get: if hasActiveBinding() && currentPlayerId() == playerId;
      allow list, create, update, delete: if false;
    }

    match /players/{playerId} {
      allow get: if signedIn()
        && exists(bindingPath(request.auth.uid))
        && (get(bindingPath(request.auth.uid)).data.playerId == playerId
          || isActiveOperator());
      allow list: if isActiveOperator();
      allow create: if signedIn()
        && !exists(bindingPath(request.auth.uid))
        && validActivePlayer(request.resource.data)
        && getAfter(bindingPath(request.auth.uid)).data.playerId == playerId;
      allow update: if validPlayerLastSeenUpdate(
          playerId,
          resource.data,
          request.resource.data
        ) || validLegacyLastSeenBackfill(
          resource.data,
          request.resource.data
        );
      allow delete: if false;

      match /activeRaidAssignments/{assignmentId} {
        // 승인 Transaction이 신청자 점유 문서 존재 여부를 확인해야 한다.
        // AuthUid·JWT는 없고 레이드 점유 식별만 담으므로 active binding 사용자에게 get만 허용한다.
        allow get: if hasActiveBinding();
        allow list: if false;
        allow create: if validInitialAssignment(
          playerId,
          assignmentId,
          request.resource.data
        ) || validJoinedAssignment(playerId, assignmentId, request.resource.data)
        || validCompletionCancelAssignmentRestore(
          playerId,
          assignmentId,
          request.resource.data
        ) || validCycleAdvanceAssignmentCreate(
          playerId,
          assignmentId,
          request.resource.data
        );
        allow update: if validAssignmentRoleChange(
          playerId,
          resource.data,
          request.resource.data
        ) || validCycleAdvanceAssignmentUpdate(
          playerId,
          assignmentId,
          resource.data,
          request.resource.data
        ) || validLegacyIncompleteAssignmentReplacement(
          playerId,
          assignmentId,
          resource.data,
          request.resource.data
        );
        allow delete: if resource != null
          && validAssignmentRemoval(playerId, resource.data);
      }

      match /events/{eventId} {
        allow get, list: if hasActiveBinding()
          && playerId == currentPlayerId();
        // 일반 create를 열지 않는다. type별 상태 전이·수신자·필드만 허용.
        allow create: if validPlayerEvent(
          playerId,
          eventId,
          request.resource.data
        );
        allow update, delete: if false;
      }

      // 요약은 본인만 읽는다. 그룹장 승인 쓰기는 대상 요약을 읽지 않고
      // 병합 쓰기 결과만 Rules가 판정한다.
      match /groupMembershipState/{docId} {
        allow get, list: if hasActiveBinding()
          && playerId == currentPlayerId();
        allow create: if validMembershipStateAdd(
          playerId,
          docId,
          [],
          0,
          request.resource.data
        ) || validLeaderApprovedMembershipStateAdd(
          playerId,
          docId,
          [],
          0,
          request.resource.data
        );
        allow update: if validMembershipStateRemove(
          playerId,
          docId,
          resource.data,
          request.resource.data
        ) || validMembershipStateAdd(
          playerId,
          docId,
          resource.data.activeGroupIds,
          resource.data.revision,
          request.resource.data
        ) || validLeaderApprovedMembershipStateAdd(
          playerId,
          docId,
          resource.data.activeGroupIds,
          resource.data.revision,
          request.resource.data
        );
        allow delete: if false;
      }

      match /groupRelations/{groupId} {
        allow get, list: if hasActiveBinding()
          && playerId == currentPlayerId();
        allow create, update: if validInitialMemberGroupRelation(
          playerId,
          groupId,
          request.resource.data
        ) || validGroupRequestRelation(
          playerId,
          groupId,
          request.resource.data
        ) || validAcceptedGroupRelation(
          playerId,
          groupId,
          request.resource.data
        ) || validJoinCodeMemberGroupRelation(
          playerId,
          groupId,
          request.resource.data
        ) || validLeaderApprovedGroupRelation(
          playerId,
          groupId,
          request.resource.data
        );
        allow delete: if validGroupMemberLeaveRelationDelete(playerId, groupId)
          || validGroupDisbandRelationDelete(playerId, groupId);
      }

      match /weeklyRaidClaims/{claimId} {
        // list는 본인만. get은 assignment와 같이 active binding이면 단건 조회 가능.
        // 파티 전체 완료 Transaction이 멤버 Claim 존재 여부를 멱등으로 확인해야 한다.
        allow get: if hasActiveBinding();
        allow list: if hasActiveBinding()
          && playerId == currentPlayerId();
        allow create: if validManualWeeklyRaidClaimCreate(
          playerId,
          claimId,
          request.resource.data
        ) || validPartyOwnerWeeklyRaidClaimCreate(
          playerId,
          claimId,
          request.resource.data
        );
        allow update: if validPartyOwnerWeeklyRaidClaimUpdate(
          playerId,
          claimId,
          resource.data,
          request.resource.data
        );
        allow delete: if validManualWeeklyRaidClaimDelete(
          playerId,
          claimId,
          resource.data
        ) || validPartyOwnerWeeklyRaidClaimDelete(
          playerId,
          claimId,
          resource.data
        );
      }

      match /characterActivity/{characterId} {
        // 그룹 상세·필터 후보는 활동 ID만 읽고 Character 표시 문서를 따로 조회한다.
        // 별도 Projection 컬렉션과 그룹 교집합 검사는 Rules 컴파일 한도를 넘긴다.
        allow get, list: if hasActiveBinding();
        allow create, update: if validCharacterActivityWrite(
          playerId,
          characterId,
          request.resource.data
        );
        allow delete: if validCharacterActivityDelete(
          playerId,
          characterId,
          resource.data
        );
      }
    }

    function validManualVerificationCode(value) {
      return value is string
        && value.matches('^LP-[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{6}$');
    }

    function manualVerificationAccountOwnedBy(gameAccountId, playerId) {
      return gameAccountId is string
        && gameAccountId.size() > 0
        && exists(/databases/$(database)/documents/gameAccounts/$(gameAccountId))
        && get(/databases/$(database)/documents/gameAccounts/$(gameAccountId))
          .data.status == 'active'
        && get(/databases/$(database)/documents/gameAccounts/$(gameAccountId))
          .data.ownerPlayerId == playerId;
    }

    function manualVerificationRequesterAlreadyOwns(data) {
      let claimPath =
        /databases/$(database)/documents/characterIdentityClaims/$(data.targetIdentityKey);
      let hasClaimAccount = exists(claimPath)
        && get(claimPath).data.gameAccountId is string
        && get(claimPath).data.gameAccountId.size() > 0;
      return hasClaimAccount
        ? manualVerificationAccountOwnedBy(
          get(claimPath).data.gameAccountId,
          data.requesterPlayerId
        )
        : ('targetGameAccountId' in data
          && manualVerificationAccountOwnedBy(
            data.targetGameAccountId,
            data.requesterPlayerId
          ));
    }

    function validManualVerificationCreate(data) {
      return hasActiveBinding()
        && data.schemaVersion == 1
        && data.requesterPlayerId == currentPlayerId()
        && data.targetIdentityKey is string
        && data.targetIdentityKey.size() > 0
        && data.localAccountId is number
        && data.localAccountId >= 1
        && data.localAccountLabelSnapshot is string
        && data.proofServerName is string
        && data.proofServerName.size() > 0
        && data.proofCharacterName is string
        && data.proofCharacterName.size() > 0
        && validManualVerificationCode(data.verificationCode)
        && data.status == 'pendingProof'
        && data.attemptNumberForTarget is number
        && data.attemptNumberForTarget >= 1
        && data.totalAttemptNumberForPlayer is number
        && data.totalAttemptNumberForPlayer >= 1
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.expiresAt is timestamp
        && (!('defenseOfRequestId' in data)
          ? !manualVerificationRequesterAlreadyOwns(data)
          : (data.defenseOfRequestId is string
            && data.defenseOfRequestId.size() > 0
            && exists(/databases/$(database)/documents/manualVerificationRequests/$(data.defenseOfRequestId))
            && get(/databases/$(database)/documents/manualVerificationRequests/$(data.defenseOfRequestId))
              .data.status == 'awaitingOwnerResponse'
            && get(/databases/$(database)/documents/manualVerificationRequests/$(data.defenseOfRequestId))
              .data.previousOwnerPlayerId == currentPlayerId()
            && request.time < get(/databases/$(database)/documents/manualVerificationRequests/$(data.defenseOfRequestId))
              .data.ownerResponseDeadlineAt));
    }

    function manualVerificationOperatorContextUnchanged(oldData, newData) {
      return newData.requesterPlayerId == oldData.requesterPlayerId
        && newData.targetIdentityKey == oldData.targetIdentityKey;
    }

    function validManualVerificationOperatorReviewBody(oldData, newData) {
      return oldData.status == 'pendingProof'
        && manualVerificationOperatorContextUnchanged(oldData, newData)
        && (
          (
            newData.status == 'cancelled'
            && newData.reviewReason is string
            && newData.reviewReason.size() > 0
            && newData.reviewedAt is timestamp
            && newData.resolvedAt is timestamp
            && newData.diff(oldData).affectedKeys().hasOnly([
              'status', 'reviewedByOperatorPlayerId', 'reviewedAt',
              'reviewReason', 'resolvedAt', 'updatedAt'
            ])
          )
          || (
            newData.status == 'blocked'
            && newData.reviewReason is string
            && newData.reviewReason.size() > 0
            && newData.reviewedAt is timestamp
            && newData.resolvedAt is timestamp
            && newData.diff(oldData).affectedKeys().hasOnly([
              'status', 'reviewedByOperatorPlayerId', 'reviewedAt',
              'reviewReason', 'resolvedAt', 'updatedAt'
            ])
          )
          || (
            newData.status == 'approved'
            && newData.targetGameAccountId is string
            && newData.targetGameAccountId.size() > 0
            && newData.reviewedAt is timestamp
            && newData.resolvedAt is timestamp
            && newData.diff(oldData).affectedKeys().hasOnly([
              'status', 'targetGameAccountId', 'reviewedByOperatorPlayerId',
              'reviewedAt', 'resolvedAt', 'updatedAt'
            ])
          )
          || validManualVerificationDefenseApprove(oldData, newData)
        );
    }

    function validManualVerificationDisputeOpenBody(oldData, newData) {
      return oldData.status == 'pendingProof'
        && !('defenseOfRequestId' in oldData
          && oldData.defenseOfRequestId is string
          && oldData.defenseOfRequestId.size() > 0)
        && manualVerificationOperatorContextUnchanged(oldData, newData)
        && newData.status == 'awaitingOwnerResponse'
        && newData.targetGameAccountId is string
        && newData.targetGameAccountId.size() > 0
        && newData.previousOwnerPlayerId is string
        && newData.previousOwnerPlayerId.size() > 0
        && newData.previousOwnerPlayerId != oldData.requesterPlayerId
        && newData.disputeOpenedAt is timestamp
        && newData.ownerResponseDeadlineAt is timestamp
        && newData.reviewedAt is timestamp
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'targetGameAccountId', 'previousOwnerPlayerId',
          'disputeOpenedAt', 'ownerResponseDeadlineAt',
          'reviewedByOperatorPlayerId', 'reviewedAt', 'updatedAt'
        ]);
    }

    function validManualVerificationDisputeDefendedBody(oldData, newData) {
      return oldData.status == 'awaitingOwnerResponse'
        && newData.status == 'defended'
        && newData.reviewReason == 'ownerDefended'
        && newData.reviewedAt is timestamp
        && newData.resolvedAt is timestamp
        && request.time < oldData.ownerResponseDeadlineAt
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'reviewedByOperatorPlayerId', 'reviewedAt',
          'reviewReason', 'resolvedAt', 'updatedAt'
        ]);
    }

    function validManualVerificationOperatorForceBody(oldData, newData) {
      return newData.status == 'transferred'
        && (newData.reviewReason == 'operatorForced'
          || newData.reviewReason == 'ownerDefenseFailed')
        && !('defenseOfRequestId' in oldData
          && oldData.defenseOfRequestId is string
          && oldData.defenseOfRequestId.size() > 0)
        && (oldData.status == 'pendingProof'
          || oldData.status == 'awaitingOwnerResponse')
        && newData.targetGameAccountId is string
        && newData.targetGameAccountId.size() > 0
        && newData.reviewedAt is timestamp
        && newData.resolvedAt is timestamp
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'targetGameAccountId', 'reviewReason',
          'reviewedByOperatorPlayerId', 'reviewedAt', 'resolvedAt', 'updatedAt'
        ]);
    }

    function validManualVerificationOperatorWrite(oldData, newData) {
      return isActiveOperator()
        && newData.reviewedByOperatorPlayerId == currentPlayerId()
        && newData.updatedAt == request.time
        && (
          (newData.status != 'transferred'
            && (
              validManualVerificationOperatorReviewBody(oldData, newData)
              || validManualVerificationDisputeOpenBody(oldData, newData)
              || validManualVerificationDisputeDefendedBody(oldData, newData)
            ))
          || validManualVerificationOperatorForceBody(oldData, newData)
        );
    }

    function unchangedManualVerificationIdentity(oldData, newData) {
      return newData.schemaVersion == oldData.schemaVersion
        && newData.requesterPlayerId == oldData.requesterPlayerId
        && newData.targetIdentityKey == oldData.targetIdentityKey
        && newData.localAccountId == oldData.localAccountId
        && newData.proofServerName == oldData.proofServerName
        && newData.proofCharacterName == oldData.proofCharacterName
        && newData.localAccountLabelSnapshot == oldData.localAccountLabelSnapshot;
    }

    function validManualVerificationRequesterCancel(oldData, newData) {
      return hasActiveBinding()
        && oldData.requesterPlayerId == currentPlayerId()
        && oldData.status == 'pendingProof'
        && newData.status == 'cancelled'
        && unchangedManualVerificationIdentity(oldData, newData)
        && newData.verificationCode == oldData.verificationCode
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'resolvedAt', 'updatedAt'
        ])
        && newData.resolvedAt == request.time
        && newData.updatedAt == request.time;
    }

    function validManualVerificationReissue(oldData, newData) {
      return hasActiveBinding()
        && oldData.requesterPlayerId == currentPlayerId()
        && oldData.status == 'pendingProof'
        && newData.status == 'pendingProof'
        && unchangedManualVerificationIdentity(oldData, newData)
        && newData.diff(oldData).affectedKeys().hasOnly([
          'verificationCode', 'createdAt', 'expiresAt', 'updatedAt',
          'attemptNumberForTarget', 'totalAttemptNumberForPlayer'
        ])
        && validManualVerificationCode(newData.verificationCode)
        && newData.createdAt == request.time
        && newData.updatedAt == request.time
        && newData.expiresAt is timestamp
        && newData.attemptNumberForTarget == oldData.attemptNumberForTarget + 1
        && newData.totalAttemptNumberForPlayer
          == oldData.totalAttemptNumberForPlayer + 1;
    }

    function validManualVerificationDefenseApprove(oldData, newData) {
      return newData.status == 'approved'
        && oldData.defenseOfRequestId is string
        && oldData.defenseOfRequestId.size() > 0
        && newData.targetGameAccountId is string
        && newData.targetGameAccountId.size() > 0
        && newData.reviewedAt is timestamp
        && newData.resolvedAt is timestamp
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'targetGameAccountId', 'reviewedByOperatorPlayerId',
          'reviewedAt', 'resolvedAt', 'updatedAt'
        ]);
    }

    function validManualVerificationDisputeTransfer(oldData, newData) {
      return hasActiveBinding()
        && oldData.status == 'awaitingOwnerResponse'
        && newData.status == 'transferred'
        && request.time >= oldData.ownerResponseDeadlineAt
        && newData.reviewReason == 'ownerResponseExpired'
        && newData.resolvedAt == request.time
        && newData.updatedAt == request.time
        && newData.diff(oldData).affectedKeys().hasOnly([
          'status', 'targetGameAccountId', 'reviewReason', 'resolvedAt', 'updatedAt'
        ]);
    }

    function validManualVerificationBlockWrite(data) {
      return isActiveOperator()
        && data.schemaVersion == 1
        && data.playerId is string
        && data.playerId.size() > 0
        && data.status == 'active'
        && data.reason is string
        && data.reason.size() > 0
        && data.blockedByOperatorPlayerId == currentPlayerId()
        && data.blockedAt == request.time
        && (
          (data.targetIdentityKey is string && data.targetIdentityKey.size() > 0)
          || (data.targetGameAccountId is string
            && data.targetGameAccountId.size() > 0)
        );
    }

    function canGetManualVerificationBlock(blockId) {
      return hasActiveBinding()
        && (
          !exists(/databases/$(database)/documents/manualVerificationBlocks/$(blockId))
          || isActiveOperator()
          || get(/databases/$(database)/documents/manualVerificationBlocks/$(blockId))
            .data.playerId == currentPlayerId()
        );
    }

    match /accountVerificationChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /activeAccountVerificationChallenges/{playerId} {
      allow read, write: if false;
    }

    match /manualVerificationRequests/{requestId} {
      allow get: if hasActiveBinding()
        && (resource.data.requesterPlayerId == currentPlayerId()
          || resource.data.previousOwnerPlayerId == currentPlayerId()
          || isActiveOperator());
      allow list: if isActiveOperator()
        || (hasActiveBinding()
          && (resource.data.requesterPlayerId == currentPlayerId()
            || resource.data.previousOwnerPlayerId == currentPlayerId()));
      allow create: if validManualVerificationCreate(request.resource.data);
      allow update: if validManualVerificationRequesterCancel(
          resource.data,
          request.resource.data
        ) || validManualVerificationReissue(
          resource.data,
          request.resource.data
        ) || validManualVerificationOperatorWrite(
          resource.data,
          request.resource.data
        ) || validManualVerificationDisputeTransfer(
          resource.data,
          request.resource.data
        );
      allow delete: if false;
    }

    match /manualVerificationBlocks/{blockId} {
      allow get: if canGetManualVerificationBlock(blockId);
      allow list: if isActiveOperator();
      allow create: if validManualVerificationBlockWrite(request.resource.data);
      allow update, delete: if false;
    }

    match /gameAccounts/{gameAccountId} {
      allow read, write: if signedIn();
    }

    match /characters/{characterId} {
      allow read, write: if signedIn();
    }

    match /characterIdentityClaims/{claimId} {
      allow read, write: if signedIn();
    }

    match /playerGameAccounts/{ownershipId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !request.resource.data.keys().hasAny([
          'representativeCharacterId',
          'representativeCharacterUpdatedAt'
        ]);
      allow update: if signedIn()
        && (!changesRepresentativeCharacter(
            resource.data,
            request.resource.data
          ) || validRepresentativeCharacterSeed(
            resource.data,
            request.resource.data
          ) || validRepresentativeCharacterUpdate(
            resource.data,
            request.resource.data
          ));
      allow delete: if signedIn();
    }

    match /recruitments/{recruitmentId} {
      allow get: if canGetRecruitment(recruitmentId);
      allow list: if canListRecruitment(resource.data);
      allow create: if validInitialRecruitment(
        recruitmentId,
        request.resource.data
      );
      allow update: if validRecruitmentJoin(
          resource.data,
          request.resource.data
        ) || validMembershipRevisionUpdate(
          recruitmentId,
          resource.data,
          request.resource.data
        ) || validPositionRevisionUpdate(
          resource.data,
          request.resource.data
        ) || validRecruitmentMemberRemoval(
          recruitmentId,
          resource.data,
          request.resource.data
        ) || validRecurrenceChange(
          resource.data,
          request.resource.data
        ) || validCycleCompletion(
          recruitmentId,
          resource.data,
          request.resource.data
        ) || validCompletionCancellation(
          recruitmentId,
          resource.data,
          request.resource.data
        ) || validCycleAdvance(
          recruitmentId,
          resource.data,
          request.resource.data
        ) || validRecruitmentDisband(
          resource.data,
          request.resource.data
        ) || validRecruitmentVisibilityChange(
          resource.data,
          request.resource.data
        );
      allow delete: if false;

      match /members/{playerId} {
        allow get, list: if canReadPrivateRecruitmentData(recruitmentId)
          || canReadPublicRecruitmentMembers(recruitmentId)
          || (hasActiveBinding() && playerId == currentPlayerId());
        allow create: if validInitialLeaderMembership(
          recruitmentId,
          playerId,
          request.resource.data
        ) || validJoinedMembership(
          recruitmentId,
          playerId,
          request.resource.data
        );
        allow update: if validMemberCharacterChange(
            recruitmentId,
            playerId,
            resource.data,
            request.resource.data
          ) || validApprovalPermissionChange(
            recruitmentId,
            playerId,
            resource.data,
            request.resource.data
          ) || validMemberPositionChange(
            recruitmentId,
            playerId,
            resource.data,
            request.resource.data
          );
        allow delete: if validMemberRemoval(
          recruitmentId,
          playerId,
          resource.data
        );
      }

      match /slots/{slotId} {
        allow get, list: if canReadPrivateRecruitmentData(recruitmentId)
          || canReadPublicRecruitmentMembers(recruitmentId);
        allow create: if validPartySlotCreate(
          recruitmentId,
          slotId,
          request.resource.data
        );
        allow update: if validPartySlotUpdate(
          recruitmentId,
          resource.data,
          request.resource.data
        );
        allow delete: if validPartySlotDelete(recruitmentId, resource.data);
      }

      match /applications/{playerId} {
        allow get: if canGetRecruitmentApplication(recruitmentId, playerId);
        allow list: if canReadPrivateRecruitmentData(recruitmentId)
          || (hasActiveBinding()
            && resource.data.applicantPlayerId == currentPlayerId());
        allow create: if validPendingApplication(
          recruitmentId,
          playerId,
          request.resource.data
        );
        allow update: if validApplicantWithdrawal(
            playerId,
            resource.data,
            request.resource.data
          ) || validApplicationDecision(
            recruitmentId,
            resource.data,
            request.resource.data
          ) || validApplicationReapply(
            recruitmentId,
            playerId,
            resource.data,
            request.resource.data
          ) || validApplicationWeeklyCompletion(
            playerId,
            resource.data,
            request.resource.data
          );
        allow delete: if false;

        match /votes/{voterPlayerId} {
          allow get, list: if canReadPrivateRecruitmentData(recruitmentId);
          allow create, update, delete: if false;
        }
      }

      match /cycles/{cycleKey} {
        allow get, list: if canReadPrivateRecruitmentData(recruitmentId);
        allow create: if validInitialCycle(
          recruitmentId,
          cycleKey,
          request.resource.data
        );
        allow update: if validCycleCancellation(
            recruitmentId,
            resource.data,
            request.resource.data
          ) || validCycleRecompletion(
            recruitmentId,
            resource.data,
            request.resource.data
          ) || validCancelledCycleEnd(
            recruitmentId,
            resource.data,
            request.resource.data
          );
        allow delete: if false;
      }
    }

    match /groups/{groupId} {
      allow get: if canGetGroup(groupId);
      // list는 공개 검색·최신 목록만 허용한다. query에 status == 'active'가 없으면 거절된다.
      allow list: if hasActiveBinding() && resource.data.status == 'active';
      allow create: if validInitialGroup(groupId, request.resource.data);
      // 공개 필드 수정은 계속 열지 않는다. 초대·신청·코드 명령의 활동 시각,
      // 인원 증가, 초대코드 플래그·표시 정책만 허용한다.
      // 그룹장 승인·코드 플래그 검증을 먼저 두어 그룹원 확인 문서를
      // 추가로 읽지 않게 한다.
      // 1인 해산은 여러 Projection 삭제를 동반하므로 가장 먼저 판정한다.
      // 초대코드와 표시 정책도 뒤의 가입·승인 복합 명령보다 먼저 종료한다.
      allow update: if validGroupDisbandUpdate(
        groupId,
        resource.data,
        request.resource.data
      ) || validGroupJoinCodeFlagUpdate(
        resource.data,
        request.resource.data
      ) || validGroupJoinCodeVisibilityUpdate(
        resource.data,
        request.resource.data
      ) || validGroupJoinCommandUpdate(
        groupId,
        resource.data,
        request.resource.data
      ) || validGroupLeaderApproveUpdate(
        resource.data,
        request.resource.data
      ) || validGroupMemberLeaveUpdate(
        groupId,
        resource.data,
        request.resource.data
      ) || validGroupLeaderTransferUpdate(
        groupId,
        resource.data,
        request.resource.data
      );
      allow delete: if false;

      match /members/{playerId} {
        allow get, list: if isCurrentGroupMember(groupId);
        allow create: if validInitialGroupMember(
          groupId,
          playerId,
          request.resource.data
        ) || validInvitedGroupMember(
          groupId,
          playerId,
          request.resource.data
        ) || validApprovedGroupMember(
          groupId,
          playerId,
          request.resource.data
        ) || validJoinCodeGroupMember(
          groupId,
          playerId,
          request.resource.data
        );
        allow update: if validGroupMemberSelfSnapshotRefresh(
          groupId,
          playerId,
          resource.data,
          request.resource.data
        ) || validGroupMemberRoleTransferUpdate(
          groupId,
          playerId,
          resource.data,
          request.resource.data
        );
        allow delete: if validGroupMemberSelfLeaveDelete(
          groupId,
          playerId,
          resource.data
        ) || validGroupMemberDisbandDelete(
          groupId,
          playerId,
          resource.data
        );
      }

      match /raidListings/{recruitmentId} {
        allow get, list: if isCurrentGroupMember(groupId);
        allow create: if validGroupRaidListingCreate(
          groupId,
          recruitmentId,
          request.resource.data
        ) || validGroupRaidListingBackfill(
          groupId,
          recruitmentId,
          request.resource.data
        );
        allow update: if validGroupRaidListingCreate(
          groupId,
          recruitmentId,
          request.resource.data
        );
        allow delete: if validGroupRaidListingDelete(groupId, recruitmentId);
      }

      // Unit 4는 초대·신청 처리에 더해 코드 가입이 pending 요청을
      // accepted로 종료하는 경로를 연다. 신청자 취소·탈퇴는 계속 닫는다.
      match /joinRelations/{playerId} {
        allow get: if hasActiveBinding()
          && (playerId == currentPlayerId() || isCurrentGroupMember(groupId));
        allow list: if isCurrentGroupMember(groupId);
        allow create: if validGroupInvitationCreate(
          groupId,
          playerId,
          0,
          0,
          true,
          request.resource.data
        ) || validGroupApplicationCreate(
          groupId,
          playerId,
          0,
          true,
          request.resource.data
        );
        allow update: if validGroupInvitationCreate(
          groupId,
          playerId,
          resource.data.revision,
          resource.data.applicationAttempt,
          reusableGroupJoinRelation(resource.data),
          request.resource.data
        ) || validGroupApplicationCreate(
          groupId,
          playerId,
          resource.data.revision,
          reusableGroupJoinRelation(resource.data),
          request.resource.data
        ) || validGroupJoinRelationDecision(
          groupId,
          playerId,
          resource.data,
          request.resource.data
        ) || validGroupApplicationDecision(
          groupId,
          playerId,
          resource.data,
          request.resource.data
        ) || validJoinCodeRelationAccept(
          groupId,
          playerId,
          resource.data,
          request.resource.data
        );
        allow delete: if false;
      }

      match /applicantStats/{playerId} {
        allow get: if hasActiveBinding()
          && (playerId == currentPlayerId() || isCurrentGroupMember(groupId));
        allow list: if isCurrentGroupLeader(groupId);
        allow create: if validGroupApplicantStatsWrite(
          groupId,
          playerId,
          0,
          request.time,
          request.resource.data
        );
        allow update: if validGroupApplicantStatsWrite(
          groupId,
          playerId,
          resource.data.applicationCount,
          resource.data.createdAt,
          request.resource.data
        );
        allow delete: if false;
      }

      // 계약 §6.2·§10. 금지 목록은 현재 그룹장만 읽고 만들고 지운다.
      // 금지된 당사자는 자기 문서의 존재 여부도 조회하지 못한다.
      // 해제는 삭제 한 건이며 이전 relation을 되돌리지 않는다.
      match /blockedPlayers/{playerId} {
        allow get, list: if isCurrentGroupLeader(groupId);
        allow create: if validGroupBlockCreate(
          groupId,
          playerId,
          request.resource.data
        );
        allow update: if false;
        allow delete: if isActiveGroupLeader(groupId);
      }
    }

    // 계약 §7·§10. 정확한 코드 단건 get만 허용하고 list는 금지한다.
    // 생성·삭제는 그룹 hasActiveJoinCode 전이와 같은 Transaction에서만 성공한다.
    match /groupJoinCodes/{code} {
      allow get: if hasActiveBinding() && validJoinCodeId(code);
      allow list: if false;
      allow create: if validJoinCodeCreate(code, request.resource.data);
      allow update: if false;
      allow delete: if validJoinCodeDelete(code);
    }

    // 컬렉션 그룹 쿼리는 중첩 경로 규칙이 적용되지 않아 재귀 와일드카드가 필요하다.
    // 신청 중 화면이 본인 신청만 회차 단위로 조회하는 용도로만 연다.
    match /{path=**}/applications/{applicantPlayerId} {
      allow list: if hasActiveBinding()
        && resource.data.applicantPlayerId == currentPlayerId();
    }
  }
}
